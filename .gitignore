bin/
obj/
.tmp-*/
*.lscache
*_wpftmp.csproj

# Logs
logs/

# Generated release artifacts
artifacts/

# User-specific files
*.user
*.suo
.vs/

# NuGet
*.nupkg
packages/

# OS
.DS_Store
Thumbs.db

# XLSX corpus private samples
test-corpus/local-private/
test-corpus/public/COIN_Tool_v1_FULL_exampledata.xlsm

# Contextures fidelity samples: kept locally for on-machine fidelity validation only;
# redistribution rights are unconfirmed, so the workbooks are never committed.
test-corpus/public/contextures/

# On-demand real-world fidelity corpus: only the manifest + downloader are committed; the
# downloaded/local workbooks and generated run outputs are never committed.
fidelity-corpus/files/
fidelity-corpus/runs/
fidelity-corpus/oracle-generated/

# On-demand real-world DOCX fidelity corpus for FreeW. Only the manifest + downloader
# are committed; downloaded/local documents and generated run outputs stay private.
freew-fidelity-corpus/files/
freew-fidelity-corpus/runs/

# Local Excel/FreeX UX parity run artifacts.
tools/ux-parity-runs/

# Generated icon asset exports
docs/assets/
docs/icon-audit/*.html
docs/icon-audit/*.json
src/FreeX.App.Host/Resources/CommandIcons/

# Temporary cross-session handoff notes
HANDOVER-INBOX.md

# Local isolated worktrees
.worktrees/
.claude/

# Diagnostic capture scripts and screenshots
capture_*.ps1
enum_tabs.ps1
*.png

# Test run artifacts
TestResults/
tools/_old_mainwindow.xaml

# Per-machine build-history token extracts (.metrics-data/project-history-tokens-*.json, or
# wherever -OutputDir points) are TRACKED IN GIT on purpose: each machine has a distinct
# $env:COMPUTERNAME, so each writes a
# distinctly-named file and different machines never conflict. Commit + pull your own machine's
# file so tools/Build-ProjectHistoryMetrics.ps1 aggregates token totals across machines. Only
# transient/partial output from that script (if any is ever added) should be ignored here.
.metrics-data/*.tmp
.metrics-data/*.partial
build.binlog
