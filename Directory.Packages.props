<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- HTML/MHTML reading (FreeW.Core.IO HtmlFileAdapter/MhtmlFileAdapter): AngleSharp = HTML5 DOM
         parser/tree-construction; MimeKit = multipart/related MIME (MHTML) wrapper. Both MIT. -->
    <PackageVersion Include="AngleSharp" Version="1.5.1" />
    <PackageVersion Include="MimeKit" Version="4.17.0" />
    <!-- Legacy binary Word (.doc/.dot) read-only import via transcode to in-memory .docx (MIT). -->
    <PackageVersion Include="DocSharp.Binary.Doc" Version="0.20.0" />
    <PackageVersion Include="DocSharp.Binary.Common" Version="0.20.0" />
    <!-- PDF text import (read-only) for FreeW. Pinned to the exact (prerelease) version the package ships. -->
    <PackageVersion Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageVersion Include="UglyToad.PdfPig.DocumentLayoutAnalysis" Version="1.7.0-custom-5" />
    <!-- Avalonia UI framework -->
    <PackageVersion Include="Avalonia" Version="12.0.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.0.4" />
    <PackageVersion Include="Avalonia.Skia" Version="12.0.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <!-- VideoLAN's maintained cross-platform media engine and native desktop views. -->
    <PackageVersion Include="LibVLCSharp" Version="3.10.0" />
    <PackageVersion Include="LibVLCSharp.Avalonia" Version="3.10.0" />
    <PackageVersion Include="LibVLCSharp.WPF" Version="3.10.0" />
    <PackageVersion Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <!-- Spreadsheet / XML -->
    <PackageVersion Include="ClosedXML" Version="0.105.0" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageVersion Include="ExcelDataReader" Version="3.8.0" />
    <PackageVersion Include="NPOI" Version="2.7.6" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <!-- In-box Windows text-to-speech for Review > Read Aloud. Microsoft-published; the modern .NET home
         of the classic System.Speech.Synthesis API (Windows-only, local synthesis — no cloud). -->
    <PackageVersion Include="System.Speech" Version="10.0.0" />
    <!-- 18A: System.Drawing.Common for pixel-level image decode in the Avalonia colour-effects helper.
         Wrapped in try/catch so the renderer degrades gracefully when GDI+ is absent. -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.0" />
    <!-- Microsoft extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <!-- Charting / rendering -->
    <PackageVersion Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageVersion Include="PDFsharp-WPF" Version="6.2.4" />
    <PackageVersion Include="SharpVectors.Wpf" Version="1.8.5" />
    <!-- Skia PDF backend for the shared PDF tier (matches the SkiaSharp Avalonia 12.0.4 resolves). -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <!-- Crash analytics -->
    <PackageVersion Include="Sentry" Version="6.5.0" />
    <!-- Self-update -->
    <PackageVersion Include="Velopack" Version="1.2.0" />
    <!-- Structured logging -->
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Test infrastructure -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="FluentAssertions" Version="8.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Xunit.StaFact" Version="1.2.69" />
  </ItemGroup>
</Project>
