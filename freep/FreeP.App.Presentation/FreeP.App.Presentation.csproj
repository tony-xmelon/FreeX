<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Free.Shared.AppServices" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FreeP.App.Presentation.Tests" />
    <!-- Shell end-to-end tests drive OleActivationService.ExternalActivationOverrideForTests so
         external OLE activation can be exercised without launching a real application, the same
         way both shells already reach WindowsOleInPlaceEngine.PayloadCreatedObserver. -->
    <InternalsVisibleTo Include="FreeP.App.Host.Tests" />
    <InternalsVisibleTo Include="FreeP.App.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreeP.App.Localization\FreeP.App.Localization.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.AppServices\Free.Shared.AppServices.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Drawing\Free.Shared.Drawing.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.IO\Free.Shared.IO.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Opc\Free.Shared.Opc.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Pdf\Free.Shared.Pdf.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Ribbon\Free.Shared.Ribbon.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Shell\Free.Shared.Shell.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Theme\Free.Shared.Theme.csproj" />
    <ProjectReference Include="..\FreeP.Core.IO\FreeP.Core.IO.csproj" />
    <ProjectReference Include="..\FreeP.Core.Model\FreeP.Core.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One renderer-independent embedded copy keeps Legal Notices available without network or
         reliance on files beside the executable. The host projects also import FamilyLegalBundle.props
         so the same source documents remain visible in packaged distributions. -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="FreeP.Legal.ProjectLicense.txt" />
    <EmbeddedResource Include="..\..\docs\legal\legal-notices.md" LogicalName="FreeP.Legal.LegalNotices.md" />
    <EmbeddedResource Include="..\..\docs\legal\privacy.md" LogicalName="FreeP.Legal.PrivacyNotice.md" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_NOTICES.md" LogicalName="FreeP.Legal.ThirdPartyNotices.md" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_LICENSES.md" LogicalName="FreeP.Legal.ThirdPartyLicenses.md" />
  </ItemGroup>

</Project>
