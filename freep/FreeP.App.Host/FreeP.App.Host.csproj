<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup><FreeBrand Condition="'$(FreeBrand)' == ''">FreeP</FreeBrand></PropertyGroup>
  <Import Project="..\..\shared\Free.Shared.Shell\BrandAssets.props" />
  <Import Project="..\..\shared\Free.Shared.Shell\FamilyLegalBundle.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>FreeP.App.Host.Program</StartupObject>
    <DefineConstants>$(DefineConstants);FREEP_WPF_RENDERER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms is on only for System.Windows.Forms.Screen (multi-monitor Presenter
         View placement, round 143 / finding F3); its implicit global usings otherwise collide
         with WPF's identically-named controls (Button/TextBox/ComboBox/CheckBox/...) across
         this project, exactly as already worked around in FreeX.App.Host.csproj. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <Import Project="..\FreeP.RendererHostVariants.props" />

  <ItemGroup Condition="'$(FreePHostAccess)' == 'true' Or '$(FreePVisualEvidenceHost)' == 'true'">
    <Compile Include="..\TestSupport\HostAccess.Wpf\MainWindow.TestAccess.cs"
             Link="MainWindow.TestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Wpf\MainWindow.DiagnosticsAccess.cs"
             Link="MainWindow.DiagnosticsAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Wpf\BackstageView.TestAccess.cs"
             Link="Backstage\BackstageView.TestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Wpf\BasicDialogs.TestAccess.cs"
             Link="BasicDialogs.TestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Wpf\EditingDialogs.TestAccess.cs"
             Link="EditingDialogs.TestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Wpf\PaneAndCustomShow.TestAccess.cs"
             Link="PaneAndCustomShow.TestAccess.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePHostAccess)' == 'true'">
    <Compile Include="..\TestSupport\HostAccess.Wpf\ChartOptionsDialogs.TestAccess.cs"
             Link="ChartOptionsDialogs.TestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Wpf\MainWindow.ExtendedTestAccess.cs"
             Link="MainWindow.ExtendedTestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Wpf\MainWindow.AccessibilityTestAccess.cs"
             Link="MainWindow.AccessibilityTestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Wpf\AutosaveCoordinator.TestAccess.cs"
             Link="AutosaveCoordinator.TestAccess.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePVisualEvidenceHost)' == 'true'">
    <Compile Include="..\TestSupport\VisualEvidence.Wpf\MainWindow.VisualCaptureAdapter.cs"
             Link="MainWindow.VisualCaptureAdapter.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePSlideShowTestSupport)' == 'true'">
    <Compile Include="..\TestSupport\SlideShow.Wpf\SlideShowMediaController.TestAccess.cs"
             Link="SlideShowMediaController.TestAccess.cs" />
    <Compile Include="..\TestSupport\SlideShow.Wpf\SlideShowWindow.TestAccess.cs"
             Link="SlideShowWindow.TestAccess.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RendererShared\SlideShowWindow.RuntimeSession.cs"
             Link="SlideShowWindow.RuntimeSession.cs" />
    <Compile Include="..\RendererShared\SlideShowWindow.PortableSurface.cs"
             Link="SlideShowWindow.PortableSurface.cs" />
    <Compile Include="..\RendererShared\MainWindow.RibbonActionProfile.cs"
             Link="MainWindow.RibbonActionProfile.cs" />
    <Compile Include="..\RendererShared\MainWindow.ChartDialogEndpoints.cs"
             Link="MainWindow.ChartDialogEndpoints.cs" />
    <Resource Include="$(BrandWindowsIconPath)" Link="Resources\$(BrandWindowsIconFileName)" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePHostAccess)' == 'true'">
    <InternalsVisibleTo Include="FreeP.App.Host.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePVisualEvidenceHost)' == 'true'">
    <InternalsVisibleTo Include="FreeP.VisualEvidence.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.Windows.SDK.NET.Ref" />
    <ProjectReference Include="..\..\shared\Free.Shared.Ribbon\Free.Shared.Ribbon.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Ribbon.Wpf\Free.Shared.Ribbon.Wpf.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Shell\Free.Shared.Shell.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Shell.Wpf\Free.Shared.Shell.Wpf.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Theme\Free.Shared.Theme.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Theme.Wpf\Free.Shared.Theme.Wpf.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.AppServices\Free.Shared.AppServices.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Drawing\Free.Shared.Drawing.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.IO\Free.Shared.IO.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Opc\Free.Shared.Opc.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Pdf.Wpf\Free.Shared.Pdf.Wpf.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Pdf.Skia\Free.Shared.Pdf.Skia.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Commands\Free.Shared.Commands.csproj" />
    <ProjectReference Include="..\FreeP.App.Localization\FreeP.App.Localization.csproj" />
    <ProjectReference Include="..\FreeP.Ribbon.Definitions\FreeP.Ribbon.Definitions.csproj" />
    <ProjectReference Include="..\FreeP.Core.Model\FreeP.Core.Model.csproj" />
    <ProjectReference Include="..\FreeP.Core.IO\FreeP.Core.IO.csproj" />
    <ProjectReference Include="..\FreeP.App.Media\FreeP.App.Media.csproj" />
    <ProjectReference Include="..\FreeP.App.Presentation\FreeP.App.Presentation.csproj" />
    <ProjectReference Include="..\FreeP.App.Recording\FreeP.App.Recording.csproj" />
    <ProjectReference Include="..\FreeP.App.Recording.Windows\FreeP.App.Recording.Windows.csproj" />
    <!-- SlideShowController was relocated to FreeP.App.Presentation for cross-platform reuse. -->
    <ProjectReference Include="..\FreeP.App.Rendering.Wpf\FreeP.App.Rendering.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Free.Shared.Ribbon" />
    <Using Include="Free.Shared.AppServices" />
    <Using Include="Free.Shared.Shell" />
    <Using Include="FreeP.App.Localization.LocalizedUiText" Alias="UiText" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpVectors.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(BrandWindowsIconPath)"
             Link="Resources\$(BrandWindowsIconFileName)"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- Reuse FreeX's Office-quality command icons (single source of truth) so any FreeP command sharing a
         FreeX equivalent draws the identical glyph. Linked, not copied — mirrors FreeW. -->
    <Content Include="..\..\src\FreeX.Ribbon.Definitions\Resources\CommandIconsSvg\**\*.svg"
             Link="Resources\CommandIconsSvg\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>$(BrandWindowsIconPath)</ApplicationIcon>
  </PropertyGroup>

</Project>
