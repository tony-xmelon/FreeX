<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <FreePWindowsBuild Condition="'$(OS)' == 'Windows_NT' Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">true</FreePWindowsBuild>
    <TargetFramework Condition="'$(FreePWindowsBuild)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(FreePWindowsBuild)' != 'true'">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="FreeP.App.Localization.LocalizedUiText" Alias="UiText" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestSupport\ChartOptionsDialogTestPlans.cs"
             Link="TestSupport\ChartOptionsDialogTestPlans.cs" />
    <ProjectReference Include="..\FreeP.App.Avalonia\FreeP.App.Avalonia.csproj" />
    <ProjectReference Include="..\FreeP.App.Recording\FreeP.App.Recording.csproj" />
  </ItemGroup>

</Project>
