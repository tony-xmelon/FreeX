<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-platform Avalonia renderer for FreeP.
    Contains SlideCanvas (Avalonia Control) that paints SlideCompositor draw ops.
    Referenced by FreeP.App.Avalonia host (14B) and tools/FreeP.RenderCompare
    (off-screen PNG rasterisation via Avalonia.Headless for parity comparison).
    net10.0 — no -windows suffix, no WPF references.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- 18A: System.Drawing.Common for pixel access in ApplyColorEffectsAvalonia.
         The call site is wrapped in try/catch so the renderer degrades gracefully when
         GDI+ is unavailable (headless CI, Linux without libgdiplus). -->
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Free.Shared.AppServices\Free.Shared.AppServices.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Drawing\Free.Shared.Drawing.csproj" />
    <ProjectReference Include="..\FreeP.Core.Model\FreeP.Core.Model.csproj" />
    <ProjectReference Include="..\FreeP.App.Presentation\FreeP.App.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FreeP.App.Rendering.Avalonia.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
