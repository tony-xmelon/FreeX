<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <FreePWindowsBuild Condition="'$(OS)' == 'Windows_NT' Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">true</FreePWindowsBuild>
    <TargetFramework Condition="'$(FreePWindowsBuild)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(FreePWindowsBuild)' != 'true'">net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>FreeP.Validation.Avalonia</AssemblyName>
    <RootNamespace>FreeP.Validation.Avalonia</RootNamespace>
    <StartupObject>FreeP.Validation.Avalonia.Program</StartupObject>
  </PropertyGroup>
  <Import Project="..\..\..\tools\ToolProjects.props" />

  <ItemGroup>
    <!-- These partials are compiled into the isolated renderer variant, not this coordinator assembly. -->
    <Compile Remove="App.ValidationHost.cs" />
    <Compile Remove="MainWindow.StartupDirtyTrace.cs" />
    <Compile Remove="MainWindow.ValidationAccessAdapter.cs" />
    <Compile Remove="Program.ValidationHost.cs" />
    <Compile Remove="StartupDirtyTrace.cs" />
    <ProjectReference Include="..\..\FreeP.App.Avalonia\FreeP.App.Avalonia.csproj"
                      AdditionalProperties="FreePValidationHost=true" />
    <ProjectReference Include="..\..\FreeP.Core.IO\FreeP.Core.IO.csproj" />
    <ProjectReference Include="..\..\FreeP.Core.Model\FreeP.Core.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FreeP.App.Avalonia.Tests" />
  </ItemGroup>

</Project>
