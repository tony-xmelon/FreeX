<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <AssemblyName>FreeP.VisualEvidence.Wpf</AssemblyName>
    <RootNamespace>FreeP.VisualEvidence.Wpf</RootNamespace>
    <StartupObject>FreeP.VisualEvidence.Wpf.Program</StartupObject>
  </PropertyGroup>
  <Import Project="..\..\..\tools\ToolProjects.props" />

  <ItemGroup>
    <!-- The adapter is compiled into the isolated renderer variant so its MainWindow partial
         retains private access without entering the normal shipping assembly. -->
    <Compile Remove="MainWindow.VisualCaptureAdapter.cs" />
    <ProjectReference Include="..\VisualEvidence\FreeP.VisualEvidence.csproj" />
    <ProjectReference Include="..\..\..\tools\Free.ToolsShared\Free.ToolsShared.csproj" />
    <ProjectReference Include="..\..\FreeP.App.Host\FreeP.App.Host.csproj"
                      AdditionalProperties="FreePVisualEvidenceHost=true" />
  </ItemGroup>

</Project>
