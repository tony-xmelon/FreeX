<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <FreePWindowsBuild Condition="'$(OS)' == 'Windows_NT' Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">true</FreePWindowsBuild>
    <TargetFramework Condition="'$(FreePWindowsBuild)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(FreePWindowsBuild)' != 'true'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FreeP</AssemblyName>
    <ApplicationTitle>FreeP</ApplicationTitle>
    <RootNamespace>FreeP.App.Avalonia</RootNamespace>
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetPlatformIdentifier)' == 'Windows'">
    <DefineConstants>$(DefineConstants);FREEP_WINDOWS_CAPTURE</DefineConstants>
  </PropertyGroup>

  <Import Project="..\FreeP.RendererHostVariants.props" />

  <ItemGroup Condition="'$(FreePVisualEvidenceHost)' == 'true' Or '$(FreePValidationHost)' == 'true'">
    <Compile Include="..\TestSupport\AvaloniaToolHost\Program.ToolHost.cs"
             Link="Program.ToolHost.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePVisualEvidenceHost)' == 'true'">
    <Compile Include="..\TestSupport\VisualEvidence.Avalonia\MainWindow.VisualCaptureAdapter.cs"
             Link="MainWindow.VisualCaptureAdapter.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePValidationHost)' == 'true'">
    <Compile Include="..\TestSupport\Validation.Avalonia\App.ValidationHost.cs"
             Link="App.ValidationHost.cs" />
    <Compile Include="..\TestSupport\Validation.Avalonia\MainWindow.StartupDirtyTrace.cs"
             Link="MainWindow.StartupDirtyTrace.cs" />
    <Compile Include="..\TestSupport\Validation.Avalonia\MainWindow.ValidationAccessAdapter.cs"
             Link="MainWindow.ValidationAccessAdapter.cs" />
    <Compile Include="..\TestSupport\Validation.Avalonia\Program.ValidationHost.cs"
             Link="Program.ValidationHost.cs" />
    <Compile Include="..\TestSupport\Validation.Avalonia\StartupDirtyTrace.cs"
             Link="StartupDirtyTrace.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePHostAccess)' == 'true' Or '$(FreePVisualEvidenceHost)' == 'true' Or '$(FreePValidationHost)' == 'true'">
    <Compile Include="..\TestSupport\HostAccess.Avalonia\MainWindow.TestAccess.cs"
             Link="MainWindow.TestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Avalonia\MainWindow.DiagnosticsAccess.cs"
             Link="MainWindow.DiagnosticsAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Avalonia\BackstageView.TestAccess.cs"
             Link="Backstage\BackstageView.TestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Avalonia\BasicDialogs.TestAccess.cs"
             Link="BasicDialogs.TestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Avalonia\EditingDialogs.TestAccess.cs"
             Link="EditingDialogs.TestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Avalonia\PaneAndCustomShow.TestAccess.cs"
             Link="PaneAndCustomShow.TestAccess.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePHostAccess)' == 'true'">
    <Compile Include="..\TestSupport\HostAccess.Avalonia\ChartOptionsDialogs.TestAccess.cs"
             Link="ChartOptionsDialogs.TestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Avalonia\MainWindow.ShellTestAccess.cs"
             Link="MainWindow.ShellTestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Avalonia\MainWindow.CommandsTestAccess.cs"
             Link="MainWindow.CommandsTestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Avalonia\MainWindow.FeaturesTestAccess.cs"
             Link="MainWindow.FeaturesTestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Avalonia\MainWindow.TailTestAccess.cs"
             Link="MainWindow.TailTestAccess.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePHostAccess)' == 'true' Or '$(FreePValidationHost)' == 'true'">
    <Compile Include="..\TestSupport\HostAccess.Avalonia\MainWindow.AccessibilityTestAccess.cs"
             Link="MainWindow.AccessibilityTestAccess.cs" />
    <Compile Include="..\TestSupport\HostAccess.Avalonia\PaneAccessibility.TestAccess.cs"
             Link="PaneAccessibility.TestAccess.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePSlideShowTestSupport)' == 'true' Or '$(FreePValidationHost)' == 'true'">
    <Compile Include="..\TestSupport\SlideShow.Avalonia\AvaloniaSlideShowMediaController.TestAccess.cs"
             Link="AvaloniaSlideShowMediaController.TestAccess.cs" />
    <Compile Include="..\TestSupport\SlideShow.Avalonia\SlideShowWindow.TestAccess.cs"
             Link="SlideShowWindow.TestAccess.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="LibVLCSharp.Avalonia" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Condition="'$(RuntimeIdentifier)' == '' Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime and package assets derive from one FreeP identity source in the shared shell. -->
    <Content Include="..\..\shared\Free.Shared.Shell\Resources\FreeP.ico"
             Link="Resources\FreeP.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\shared\Free.Shared.Shell\Resources\FreeP.svg"
             Link="Resources\FreeP.svg"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\FreeP.Core.Model\FreeP.Core.Model.csproj" />
    <ProjectReference Include="..\FreeP.Core.IO\FreeP.Core.IO.csproj" />
    <ProjectReference Include="..\FreeP.App.Presentation\FreeP.App.Presentation.csproj" />
    <ProjectReference Include="..\FreeP.App.Recording\FreeP.App.Recording.csproj" />
    <ProjectReference Include="..\FreeP.App.Recording.Windows\FreeP.App.Recording.Windows.csproj"
                      Condition="'$(TargetPlatformIdentifier)' == 'Windows'" />
    <ProjectReference Include="..\FreeP.App.Ole.Windows\FreeP.App.Ole.Windows.csproj"
                      Condition="'$(TargetPlatformIdentifier)' == 'Windows'" />
    <ProjectReference Include="..\FreeP.App.Media\FreeP.App.Media.csproj" />
    <ProjectReference Include="..\FreeP.App.Rendering.Avalonia\FreeP.App.Rendering.Avalonia.csproj" />
    <ProjectReference Include="..\FreeP.Ribbon.Definitions\FreeP.Ribbon.Definitions.csproj" />
    <ProjectReference Include="..\FreeP.App.Localization\FreeP.App.Localization.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.AppServices\Free.Shared.AppServices.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.AppServices.Windows\Free.Shared.AppServices.Windows.csproj"
                      Condition="'$(TargetPlatformIdentifier)' == 'Windows'" />
    <ProjectReference Include="..\..\shared\Free.Shared.Drawing\Free.Shared.Drawing.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.IO\Free.Shared.IO.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Pdf.Skia\Free.Shared.Pdf.Skia.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Ribbon\Free.Shared.Ribbon.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Ribbon.Avalonia\Free.Shared.Ribbon.Avalonia.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Shell.Avalonia\Free.Shared.Shell.Avalonia.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Theme\Free.Shared.Theme.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Theme.Avalonia\Free.Shared.Theme.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="FreeP.App.Localization.LocalizedUiText" Alias="UiText" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePHostAccess)' == 'true'">
    <InternalsVisibleTo Include="FreeP.App.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePVisualEvidenceHost)' == 'true'">
    <InternalsVisibleTo Include="FreeP.VisualEvidence.Avalonia" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePValidationHost)' == 'true'">
    <InternalsVisibleTo Include="FreeP.Validation.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Free.Shared.AppServices" />
  </ItemGroup>

</Project>
