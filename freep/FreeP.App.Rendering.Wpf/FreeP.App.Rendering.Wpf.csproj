<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF rasterisation library for FreeP.
    Contains SlideCanvas (WPF FrameworkElement) that paints SlideCompositor draw ops.
    Referenced by both FreeP.App.Host (live display) and tools/FreeP.RenderCompare
    (off-screen PNG rasterisation for parity comparison).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FreePRendererTestSupport)' == 'true'">
    <OutputPath>bin\TestSupport\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\TestSupport\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(FreePRendererTestSupport)' == 'true'">
    <Compile Include="..\TestSupport\Rendering.Wpf\CanvasGestureHandler.TestAccess.cs"
             Link="CanvasGestureHandler.TestAccess.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Free.Shared.Shell.Wpf\Free.Shared.Shell.Wpf.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Drawing\Free.Shared.Drawing.csproj" />
    <ProjectReference Include="..\FreeP.App.Ole.Windows\FreeP.App.Ole.Windows.csproj" />
    <ProjectReference Include="..\FreeP.Core.Model\FreeP.Core.Model.csproj" />
    <ProjectReference Include="..\FreeP.App.Presentation\FreeP.App.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FreeP.App.Host.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
