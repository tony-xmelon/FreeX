<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF rasterisation library for FreeP.
    Contains SlideCanvas (WPF FrameworkElement) that paints SlideCompositor draw ops.
    Referenced by both FreeP.App.Host (live display) and tools/FreeP.RenderCompare
    (off-screen PNG rasterisation for parity comparison).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FreePRendererTestSupport)' == 'true'">
    <OutputPath>bin/TestSupport/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/TestSupport/$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
  </PropertyGroup>

  <!-- FreePRendererTestSupport arrives as a GLOBAL property (the test projects set it through
       AdditionalProperties on their ProjectReference to this project), and global properties
       propagate transitively. Only this project reads it; every dependency below just inherits it,
       which makes MSBuild treat "Free.Shared.Shell.Wpf with the property" and "Free.Shared.Shell.Wpf
       without it" as two different projects. Both instances then compile to the SAME
       obj/ path, because those projects do not redirect IntermediateOutputPath, and when the two
       builds overlap one loses the race:

         CSC : error CS2012: Cannot open '...\Free.Shared.Shell.Wpf.dll' for writing
         error MSB3061: Unable to delete file '...obj\Release\...'

       Undefining it for our references collapses each dependency back to a single instance. -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <UndefineProperties>FreePRendererTestSupport</UndefineProperties>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup Condition="'$(FreePRendererTestSupport)' == 'true'">
    <Compile Include="../TestSupport/Rendering.Wpf/CanvasGestureHandler.TestAccess.cs"
             Link="CanvasGestureHandler.TestAccess.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/Free.Shared.Shell.Wpf/Free.Shared.Shell.Wpf.csproj" />
    <ProjectReference Include="../../shared/Free.Shared.Drawing/Free.Shared.Drawing.csproj" />
    <ProjectReference Include="../FreeP.App.Ole.Windows/FreeP.App.Ole.Windows.csproj" />
    <ProjectReference Include="../FreeP.Core.Model/FreeP.Core.Model.csproj" />
    <ProjectReference Include="../FreeP.App.Presentation/FreeP.App.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreePRendererTestSupport)' == 'true'">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FreeP.App.Host.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
