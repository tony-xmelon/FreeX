<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PowerPoint interop-compare harness for FreeP parity validation (Wave 1E).
    Drives PowerPoint COM to export each slide of a .pptx to PNG (ground truth),
    optionally invokes the FreeP renderer to produce its own PNGs, then diffs the
    two sets pixel-by-pixel.  Run on demand; not part of the automated test gate.

    Modes (see Program.cs):
      powerpoint-export, freep-render (stub), diff, generate-corpus
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>FreeP.RenderCompare.Program</StartupObject>
    <Platforms>x64</Platforms>
    <!-- Suppress COM interop late-binding warnings from dynamic usage -->
    <NoWarn>$(NoWarn);CS8600;CS8602</NoWarn>
  </PropertyGroup>
  <Import Project="..\ToolProjects.props" />

  <ItemGroup>
    <InternalsVisibleTo Include="FreeP.RenderCompare.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Free.ToolsShared\Free.ToolsShared.csproj" />
    <ProjectReference Include="..\FreeX.ToolsShared.Wpf\FreeX.ToolsShared.Wpf.csproj" />
    <ProjectReference Include="..\..\freep\FreeP.Core.IO\FreeP.Core.IO.csproj" />
    <ProjectReference Include="..\..\freep\FreeP.App.Presentation\FreeP.App.Presentation.csproj" />
    <ProjectReference Include="..\..\freep\FreeP.App.Rendering.Wpf\FreeP.App.Rendering.Wpf.csproj" />
    <ProjectReference Include="..\..\freep\FreeP.App.Rendering.Avalonia\FreeP.App.Rendering.Avalonia.csproj" />
  </ItemGroup>

</Project>
