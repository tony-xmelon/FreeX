<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Portable net10.0: orchestration shells out to dotnet/docker/exe via Process,
         so the runner itself needs no WPF/Avalonia/RID. Capture (WPF host exe, Avalonia
         linux-x64 publish + Docker) is invoked as external processes. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="..\ToolProjects.props" />

  <ItemGroup>
    <ProjectReference Include="..\Free.ToolsShared\Free.ToolsShared.csproj" />
    <ProjectReference Include="..\FreeX.ParityCompare.Core\FreeX.ParityCompare.Core.csproj" />
  </ItemGroup>

</Project>
