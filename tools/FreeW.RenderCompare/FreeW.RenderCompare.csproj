<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless FreeW page-render harness for the on-demand DOCX visual-fidelity comparison.
    Loads each corpus .docx through DocxReader, hosts it in a DocumentView, and rasterizes every
    paginated page through the app's real print/preview paginator to PNG. Included in
    solution preflight for project hygiene; run on demand alongside the Word ground-truth export. See
    freew-fidelity-corpus/README.md and docs/fidelity/.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>FreeW.RenderCompare.Program</StartupObject>
  </PropertyGroup>
  <Import Project="..\ToolProjects.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\freew\FreeW.App.Host\FreeW.App.Host.csproj"
                      AdditionalProperties="FreeWRenderCompareSupport=true" />
    <ProjectReference Include="..\..\freew\FreeW.Core.IO\FreeW.Core.IO.csproj" />
    <ProjectReference Include="..\..\freew\FreeW.Core.Model\FreeW.Core.Model.csproj" />
  </ItemGroup>

</Project>
