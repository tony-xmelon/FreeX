{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freex.local/schemas/freep-linux-rich-text-shortcut-physical-v1.json",
  "title": "FreeP Linux physical rich-text evidence",
  "description": "Strict host contract for the dedicated non-exhaustive physical X11 rich-text lanes, including grouped-child caret navigation.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "suite", "platform", "shell", "app", "baseline", "appSurface", "window", "parameters", "coverage", "contractValidation", "screenshots", "summary", "results"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "freep-linux-rich-text-shortcut-physical" },
    "platform": { "const": "linux" },
    "shell": { "const": "avalonia" },
    "app": { "const": "FreeP" },
    "baseline": { "const": false },
    "appSurface": { "enum": ["in-canvas-rich-text-soft-break", "in-canvas-grouped-child-rich-text", "in-canvas-grouped-child-caret"] },
    "window": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "pattern", "visible"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "pattern": { "const": "21-comments-notes.pptx" },
        "visible": { "const": true }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["scope", "exhaustive"],
      "properties": {
        "scope": { "enum": ["physical FreeP rich-editor soft-break evidence lane", "physical FreeP grouped-child rich-editor edit-save-reopen lane", "physical FreeP grouped-child caret navigation selection edit-save-reopen lane"] },
        "exhaustive": { "const": false }
        }
    },
    "semanticReadback": {
      "type": ["object", "null"],
      "properties": {
        "tool": { "const": "xclip" },
        "selection": { "const": "clipboard" },
        "transcripts": {
          "type": "array",
          "const": [
            "grouped-caret-selection",
            "grouped-caret-vertical-down",
            "grouped-caret-vertical-roundtrip"
          ]
        },
        "reopenProof": { "const": "grouped-caret-reopen-proof.txt" }
      }
    },
    "contractValidation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "validator", "contractReference"],
      "properties": {
        "status": { "const": "passed" },
        "validator": { "const": "tools/Run-FreePRichTextShortcutValidation.ps1" },
        "contractReference": { "const": "tools/LinuxInteractiveDocker/freep-rich-text-shortcut-validation.schema.json" }
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "const": "screenshot" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["passed", "failed", "total"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total": { "const": 5 }
      }
    },
    "results": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/resultVisible" },
        { "$ref": "#/$defs/resultInput" },
        { "$ref": "#/$defs/resultSaved" },
        { "$ref": "#/$defs/resultUndo" },
        { "$ref": "#/$defs/resultRedo" }
      ],
      "items": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "appSurface": { "const": "in-canvas-grouped-child-caret" } },
        "required": ["appSurface"]
      },
      "then": {
        "required": ["semanticReadback"],
        "properties": {
          "semanticReadback": {
            "type": "object",
            "required": ["tool", "selection", "transcripts", "reopenProof"]
          }
        }
      }
    }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "category", "status", "evidenceLevel", "evidence", "note"],
      "properties": {
        "category": { "const": "physical-x11-rich-text-shortcut" },
        "status": { "enum": ["passed", "failed"] },
        "evidenceLevel": { "const": "physical-x11-input" },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "resultVisible": { "allOf": [{ "$ref": "#/$defs/result" }, { "properties": { "id": { "const": "visible-window-discovery" } } }] },
    "resultInput": { "allOf": [{ "$ref": "#/$defs/result" }, { "properties": { "id": { "const": "rich-editor-physical-soft-break-input" } } }] },
    "resultSaved": { "allOf": [{ "$ref": "#/$defs/result" }, { "properties": { "id": { "const": "saved-soft-break-native-package" } } }] },
    "resultUndo": { "allOf": [{ "$ref": "#/$defs/result" }, { "properties": { "id": { "const": "undo-restores-original-text" } } }] },
    "resultRedo": { "allOf": [{ "$ref": "#/$defs/result" }, { "properties": { "id": { "const": "redo-restores-soft-break" } } }] }
  }
}
