{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freex.local/schemas/family-linux-physical-baseline-v1.json",
  "title": "FreeX family Linux physical X11 baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "suite", "platform", "shell", "app", "baseline",
    "appSurface", "window", "parameters", "coverage", "contractValidation",
    "screenshots", "summary", "results"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "family-linux-physical-baseline" },
    "platform": { "const": "linux" },
    "shell": { "const": "avalonia" },
    "app": { "enum": ["FreeW", "FreeP"] },
    "baseline": { "const": true },
    "appSurface": { "type": "string", "minLength": 1 },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "pattern", "visible"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "visible": { "const": true }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ribbonTabKey", "fileKey", "fileSurface"],
      "properties": {
        "ribbonTabKey": { "type": "string", "minLength": 1 },
        "fileKey": { "type": "string", "minLength": 1 },
        "fileSurface": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "exhaustive", "exhaustiveFreeXRunner"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "exhaustive": { "const": false },
        "exhaustiveFreeXRunner": { "type": "string", "minLength": 1 }
      }
    },
    "contractValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "validator", "contractReference"],
      "properties": {
        "status": { "enum": ["pending", "passed"] },
        "validator": { "type": "string", "minLength": 1 },
        "contractReference": { "type": "string", "minLength": 1 }
      }
    },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "const": "screenshot" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "total"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      }
    },
    "results": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "status", "evidenceLevel", "evidence", "note"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "const": "physical-x11-smoke" },
          "status": { "enum": ["passed", "failed"] },
          "evidenceLevel": { "const": "physical-x11-input" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "note": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "app": { "const": "FreeP" } } },
      "then": { "properties": { "results": { "minItems": 24, "maxItems": 24 } } }
    },
    {
      "if": { "properties": { "app": { "const": "FreeW" } } },
      "then": { "properties": { "results": { "minItems": 45, "maxItems": 45 } } }
    }
  ]
}
