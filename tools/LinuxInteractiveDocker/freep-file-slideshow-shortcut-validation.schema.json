{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freex.local/schemas/freep-linux-file-slideshow-shortcut-physical-v1.json",
  "title": "FreeP Linux physical file and slideshow shortcut evidence",
  "description": "Structural reference for the dedicated non-exhaustive lane. The PowerShell runner performs the exact ten-row contract and artifact checks; this schema does not claim exhaustive product coverage or execute a JSON Schema engine.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion", "suite", "platform", "shell", "app", "baseline",
    "appSurface", "window", "parameters", "coverage", "contractValidation",
    "screenshots", "summary", "results"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "freep-linux-file-slideshow-shortcut-physical" },
    "platform": { "const": "linux" },
    "shell": { "const": "avalonia" },
    "app": { "const": "FreeP" },
    "baseline": { "const": false },
    "appSurface": { "const": "document-editor-file-slideshow-shortcuts" },
    "window": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "pattern", "visible"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "pattern": { "const": "21-comments-notes.pptx" },
        "visible": { "const": true }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["scope", "exhaustive"],
      "properties": {
        "scope": { "const": "physical FreeP file/slideshow shortcut evidence lane" },
        "exhaustive": { "const": false }
      }
    },
    "contractValidation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "validator", "contractReference"],
      "properties": {
        "status": { "enum": ["pending", "passed"] },
        "validator": { "type": "string", "minLength": 1 },
        "contractReference": { "type": "string", "minLength": 1 }
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "const": "screenshot" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["passed", "failed", "total"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total": { "const": 10 }
      }
    },
    "results": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "category", "status", "evidenceLevel", "evidence", "note"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "visible-window-discovery",
              "file-new-shortcut-lifecycle",
              "file-open-shortcut-lifecycle",
              "file-save-shortcut-current-path",
              "file-save-as-shortcut-lifecycle",
              "print-shortcut-backstage-lifecycle",
              "slideshow-from-beginning-lifecycle",
              "slideshow-from-current-lifecycle",
              "find-shortcut-lifecycle",
              "replace-shortcut-lifecycle"
            ]
          },
          "category": { "const": "physical-x11-file-slideshow-shortcut" },
          "status": { "enum": ["passed", "failed"] },
          "evidenceLevel": { "const": "physical-x11-input" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
