{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freex.local/schemas/freew-linux-table-pagination-physical-v1.json",
  "title": "FreeW Linux physical table pagination evidence",
  "description": "Strict host-promotion contract for the FreeW table-page composition stress surface.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "suite", "platform", "shell", "app", "baseline", "appSurface", "window", "parameters", "coverage", "contractValidation", "screenshots", "processExitCode", "summary", "results"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "freew-linux-table-pagination-physical" },
    "platform": { "const": "linux" },
    "shell": { "const": "avalonia" },
    "app": { "const": "FreeW" },
    "baseline": { "const": false },
    "appSurface": { "const": "table-page-composition-stress" },
    "window": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "pattern", "visible"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "visible": { "const": true }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true,
      "required": ["fixture"],
      "properties": {
        "fixture": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "dpi": { "type": "integer", "minimum": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "exhaustive"],
      "properties": {
        "scope": { "const": "physical FreeW table pagination and third-page composition evidence lane" },
        "exhaustive": { "const": false }
      }
    },
    "contractValidation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "validator", "contractReference"],
      "properties": {
        "status": { "const": "passed" },
        "validator": { "const": "tools/Run-FreeWTablePaginationValidation.ps1" },
        "contractReference": { "const": "tools/LinuxInteractiveDocker/freew-table-pagination-validation.schema.json" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "total"],
      "properties": {
        "passed": { "type": "integer", "const": 5 },
        "failed": { "type": "integer", "const": 0 },
        "total": { "const": 5 }
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "const": "screenshot" }
        }
      }
    },
    "processExitCode": { "type": "integer", "minimum": 0 },
    "results": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "prefixItems": [
        { "$ref": "#/$defs/visibleWindowDiscovery" },
        { "$ref": "#/$defs/generatedFixtureHashIntegrity" },
        { "$ref": "#/$defs/physicalThirdPageNavigation" },
        { "$ref": "#/$defs/nonblankFinalPageRender" },
        { "$ref": "#/$defs/sharedPlanProof" }
      ],
      "items": false
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "category", "evidenceLevel", "status", "evidence", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "enum": ["physical-x11-table-pagination", "deterministic-shared-plan"] },
        "evidenceLevel": { "enum": ["physical-x11-input", "focused-test"] },
        "status": { "enum": ["passed", "failed"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "visibleWindowDiscovery": { "allOf": [{ "$ref": "#/$defs/result" }, { "properties": { "id": { "const": "visible-window-discovery" }, "category": { "const": "physical-x11-table-pagination" }, "evidenceLevel": { "const": "physical-x11-input" } } }] },
    "generatedFixtureHashIntegrity": { "allOf": [{ "$ref": "#/$defs/result" }, { "properties": { "id": { "const": "generated-fixture-hash-integrity" }, "category": { "const": "physical-x11-table-pagination" }, "evidenceLevel": { "const": "physical-x11-input" } } }] },
    "physicalThirdPageNavigation": { "allOf": [{ "$ref": "#/$defs/result" }, { "properties": { "id": { "const": "physical-third-page-navigation" }, "category": { "const": "physical-x11-table-pagination" }, "evidenceLevel": { "const": "physical-x11-input" } } }] },
    "nonblankFinalPageRender": { "allOf": [{ "$ref": "#/$defs/result" }, { "properties": { "id": { "const": "nonblank-final-page-render" }, "category": { "const": "physical-x11-table-pagination" }, "evidenceLevel": { "const": "physical-x11-input" } } }] },
    "sharedPlanProof": { "allOf": [{ "$ref": "#/$defs/result" }, { "properties": { "id": { "const": "shared-plan-proof" }, "category": { "const": "deterministic-shared-plan" }, "evidenceLevel": { "const": "focused-test" } } }] }
  }
}
