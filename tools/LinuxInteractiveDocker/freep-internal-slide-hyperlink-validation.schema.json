{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "suite", "platform", "shell", "app", "summary", "results"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "freep-internal-slide-hyperlink-x11" },
    "platform": { "const": "linux" },
    "shell": { "const": "avalonia" },
    "app": { "const": "FreeP" },
    "summary": { "type": "object", "required": ["passed", "failed", "total"], "properties": { "passed": { "const": 1 }, "failed": { "const": 0 }, "total": { "const": 1 } } },
    "results": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": { "type": "object", "required": ["id", "category", "status", "evidenceLevel", "evidence"], "properties": {
        "id": { "const": "internal-slide-hyperlink-physical-workflow" },
        "category": { "const": "physical-x11-input" },
        "status": { "const": "passed" },
        "evidenceLevel": { "const": "physical-x11-input" },
        "evidence": { "type": "array", "minItems": 9, "contains": { "const": "authoring-postcondition.txt" } }
      } }
    }
  }
}
