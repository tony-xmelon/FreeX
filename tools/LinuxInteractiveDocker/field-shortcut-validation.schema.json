{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FreeW Avalonia field shortcut physical validation",
  "type": "object",
  "required": ["schemaVersion", "suite", "platform", "shell", "app", "baseline", "coverage", "window", "screenshots", "summary", "results"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "freew-linux-field-shortcut-physical" },
    "platform": { "const": "linux" },
    "shell": { "const": "avalonia" },
    "app": { "const": "FreeW" },
    "baseline": { "const": false },
    "appSurface": { "const": "document-editor-field-shortcuts" },
    "coverage": {
      "type": "object",
      "required": ["scope", "exhaustive"],
      "properties": {
        "scope": { "const": "physical Alt+F9/F9 field shortcut lane" },
        "exhaustive": { "const": false }
      },
      "additionalProperties": true
    },
    "window": {
      "type": "object",
      "required": ["id", "title", "pattern", "visible"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "pattern": { "const": "FreeW" },
        "visible": { "const": true }
      },
      "additionalProperties": true
    },
    "screenshots": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "const": "screenshot" }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": ["passed", "failed", "total"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total": { "const": 4 }
      },
      "additionalProperties": true
    },
    "results": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "category", "status", "evidenceLevel", "evidence", "note"],
        "properties": {
          "id": { "type": "string", "enum": ["visible-window-discovery", "field-code-shortcut-show", "field-code-shortcut-hide", "field-update-shortcut-persist"] },
          "category": { "const": "physical-x11-field-shortcut" },
          "status": { "enum": ["passed", "failed"] },
          "evidenceLevel": { "const": "physical-x11-input" },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "note": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
