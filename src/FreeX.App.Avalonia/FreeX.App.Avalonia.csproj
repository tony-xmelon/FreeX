<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\FreeX.App.Localization\FreeX.App.Localization.csproj" />
    <ProjectReference Include="..\FreeX.App.Presentation\FreeX.App.Presentation.csproj" />
    <ProjectReference Include="..\FreeX.App.Services\FreeX.App.Services.csproj" />
    <ProjectReference Include="..\FreeX.Core.Calc\FreeX.Core.Calc.csproj" />
    <ProjectReference Include="..\FreeX.Core.Commands\FreeX.Core.Commands.csproj" />
    <ProjectReference Include="..\FreeX.Core.IO\FreeX.Core.IO.csproj" />
    <ProjectReference Include="..\FreeX.Core.Model\FreeX.Core.Model.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Drawing\Free.Shared.Drawing.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Localization\Free.Shared.Localization.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Pdf\Free.Shared.Pdf.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Pdf.Skia\Free.Shared.Pdf.Skia.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Ribbon\Free.Shared.Ribbon.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Shell\Free.Shared.Shell.csproj" />
    <ProjectReference Include="..\FreeX.Ribbon.Definitions\FreeX.Ribbon.Definitions.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Ribbon.Avalonia\Free.Shared.Ribbon.Avalonia.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Shell.Avalonia\Free.Shared.Shell.Avalonia.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Theme.Avalonia\Free.Shared.Theme.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FreeX.App.Avalonia.Tests" />
    <InternalsVisibleTo Include="FreeX.App.Avalonia.CaptureTests" />
    <InternalsVisibleTo Include="FreeX.App.Avalonia.CaptureTests.Batch2" />
    <InternalsVisibleTo Include="FreeX.App.Avalonia.CaptureTests.Batch3" />
    <InternalsVisibleTo Include="FreeX.App.Avalonia.CaptureTests.Batch4" />
    <InternalsVisibleTo Include="FreeX.App.Avalonia.CaptureTests.Batch5" />
    <InternalsVisibleTo Include="FreeX.App.Avalonia.CaptureTests.Batch6" />
    <InternalsVisibleTo Include="FreeX.App.Avalonia.CaptureTests.Batch7" />
    <InternalsVisibleTo Include="FreeX.Validation.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Packaging\macos\FreeX.icns" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Keep the runtime resource path through a project link to the neutral shared canonical ICO. -->
    <Content Include="..\..\shared\Free.Shared.Shell\Resources\FreeX.ico"
             Link="Resources\FreeX.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-macos'">
    <Compile Remove="MacOs\**\*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>FreeX</AssemblyName>
    <ApplicationTitle>FreeX</ApplicationTitle>
    <!-- Keep in sync with the Windows host version. Without this the assembly defaults to 1.0.0, which
         crash analytics and the Velopack update check would report instead of the real version. -->
    <Version>0.5.0</Version>
    <InformationalVersion>0.5.0</InformationalVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>FreeX.App.Avalonia</RootNamespace>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-macos'">12.0</SupportedOSPlatformVersion>
    <TargetFramework Condition="'$(EnableMacOsTargetFramework)' != 'true'">net10.0</TargetFramework>
    <TargetFrameworks Condition="'$(EnableMacOsTargetFramework)' == 'true'">net10.0;net10.0-macos</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <DefineConstants>$(DefineConstants);FREEX_MACOS_SHARE_SHEET</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Free.Shared.Drawing" />
    <Using Include="Free.Shared.Opc" />
    <Using Include="FreeX.App.Localization.LocalizedUiText" Alias="UiText" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Free.Shared.AppServices" />
    <Using Include="Free.Shared.AppServices.Printing" />
    <Using Include="FreeX.App.Presentation.FormulaBar" />
  </ItemGroup>
</Project>
