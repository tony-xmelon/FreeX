<Window x:Class="FreeX.App.Host.FindReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FreeX.App.Host"
        xmlns:services="clr-namespace:FreeX.App.Services;assembly=FreeX.App.Services"
        Width="{x:Static services:FindReplaceDialogPlanner.Width}"
        Height="{x:Static services:FindReplaceDialogPlanner.Height}"
        MinWidth="{x:Static services:FindReplaceDialogPlanner.MinWidth}"
        MinHeight="{x:Static services:FindReplaceDialogPlanner.MinHeight}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="FindReplaceTabs" Grid.Row="0" Margin="0,0,0,10" SelectionChanged="FindReplaceTabs_SelectionChanged">
            <TabItem x:Name="FindTab">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Static local:FindReplaceDialog.FindReplaceFieldLabelColumnWidth}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="FindWhatLabel" Target="{Binding ElementName=FindBox}" VerticalAlignment="Center"/>
                    <TextBox x:Name="FindBox" Grid.Column="1" MinWidth="{x:Static services:FindReplaceDialogPlanner.FieldMinWidth}" KeyDown="FindBox_KeyDown" TextChanged="FindBox_TextChanged"/>
                    <Button x:Name="FindFormatButton" Grid.Column="2" Width="{x:Static services:FindReplaceDialogPlanner.FormatButtonWidth}" Margin="8,0,0,0" Click="FindFormatButton_Click"/>
                    <Button x:Name="FindClearFormatButton" Grid.Column="3" Width="{x:Static services:FindReplaceDialogPlanner.ClearFormatButtonWidth}" Margin="6,0,0,0" Visibility="Collapsed" Click="FindClearFormatButton_Click"/>
                    <Button x:Name="FindChooseFormatFromCellButton" Grid.Column="4" Width="{x:Static services:FindReplaceDialogPlanner.ChooseFormatButtonWidth}" Margin="6,0,0,0" Click="ChooseFindFormatFromCellButton_Click"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="ReplaceTab">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Static local:FindReplaceDialog.FindReplaceFieldLabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="ReplaceFindWhatLabel" Target="{Binding ElementName=ReplaceFindBox}" VerticalAlignment="Center"/>
                        <TextBox x:Name="ReplaceFindBox" Grid.Column="1" MinWidth="{x:Static services:FindReplaceDialogPlanner.FieldMinWidth}" KeyDown="FindBox_KeyDown" TextChanged="FindBox_TextChanged"/>
                        <Button x:Name="ReplaceFindFormatButton" Grid.Column="2" Width="{x:Static services:FindReplaceDialogPlanner.FormatButtonWidth}" Margin="8,0,0,0" Click="FindFormatButton_Click"/>
                        <Button x:Name="ReplaceFindClearFormatButton" Grid.Column="3" Width="{x:Static services:FindReplaceDialogPlanner.ClearFormatButtonWidth}" Margin="6,0,0,0" Visibility="Collapsed" Click="FindClearFormatButton_Click"/>
                        <Button x:Name="ReplaceFindChooseFormatFromCellButton" Grid.Column="4" Width="{x:Static services:FindReplaceDialogPlanner.ChooseFormatButtonWidth}" Margin="6,0,0,0" Click="ChooseFindFormatFromCellButton_Click"/>
                    </Grid>

                    <Grid x:Name="ReplaceRow" Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Static local:FindReplaceDialog.FindReplaceFieldLabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="ReplaceWithLabel" Target="{Binding ElementName=ReplaceBox}" VerticalAlignment="Center"/>
                        <TextBox x:Name="ReplaceBox" Grid.Column="1" MinWidth="{x:Static services:FindReplaceDialogPlanner.FieldMinWidth}"/>
                        <Button x:Name="ReplaceWithFormatButton" Grid.Column="2" Width="{x:Static services:FindReplaceDialogPlanner.FormatButtonWidth}" Margin="8,0,0,0" Click="ReplaceWithFormatButton_Click"/>
                        <Button x:Name="ReplaceWithClearFormatButton" Grid.Column="3" Width="{x:Static services:FindReplaceDialogPlanner.ClearFormatButtonWidth}" Margin="6,0,0,0" Visibility="Collapsed" Click="ReplaceWithClearFormatButton_Click"/>
                        <Button x:Name="ReplaceWithChooseFormatFromCellButton" Grid.Column="4" Width="{x:Static services:FindReplaceDialogPlanner.ChooseFormatButtonWidth}" Margin="6,0,0,0" Click="ChooseReplaceWithFormatFromCellButton_Click"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Expander x:Name="OptionsExpander"
                  Grid.Row="1"
                  IsExpanded="False"
                  Expanded="OptionsExpander_Expanded"
                  Collapsed="OptionsExpander_Collapsed"
                  Margin="0,0,0,10">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Static local:FindReplaceDialog.FindReplaceFieldLabelColumnWidth}"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label x:Name="WithinLabel" Target="{Binding ElementName=WithinCombo}" VerticalAlignment="Center"/>
                <ComboBox x:Name="WithinCombo" Grid.Column="1" SelectedIndex="0" Margin="0,0,12,6"/>

                <Label x:Name="SearchLabel" Target="{Binding ElementName=SearchCombo}" Grid.Column="2" VerticalAlignment="Center"/>
                <ComboBox x:Name="SearchCombo" Grid.Column="3" SelectedIndex="0" Margin="0,0,0,6"/>

                <Label x:Name="LookInLabel" Target="{Binding ElementName=LookInCombo}" Grid.Row="1" VerticalAlignment="Center"/>
                <ComboBox x:Name="LookInCombo" Grid.Row="1" Grid.Column="1" SelectedIndex="0" Margin="0,0,12,6"/>

                <CheckBox x:Name="MatchCaseBox" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,2,12,0"/>
                <CheckBox x:Name="MatchEntireBox" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,2,0,0"/>
            </Grid>
        </Expander>

        <DataGrid x:Name="FindResultsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  MinHeight="{x:Static services:FindReplaceDialogPlanner.ResultsMinimumHeight}"
                  Margin="0,0,0,8"
                  SelectionChanged="FindResultsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Book}" Width="{x:Static local:FindReplaceDialog.FindReplaceResultBookColumnWidth}"/>
                <DataGridTextColumn Binding="{Binding Sheet}" Width="{x:Static local:FindReplaceDialog.FindReplaceResultSheetColumnWidth}"/>
                <DataGridTextColumn Binding="{Binding Name}" Width="{x:Static local:FindReplaceDialog.FindReplaceResultNameColumnWidth}"/>
                <DataGridTextColumn Binding="{Binding Cell}" Width="{x:Static local:FindReplaceDialog.FindReplaceResultCellColumnWidth}"/>
                <DataGridTextColumn Binding="{Binding Value}" Width="*"/>
                <DataGridTextColumn Binding="{Binding Formula}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusLabel" Grid.Row="3" Foreground="#555" FontSize="11" MinHeight="18" Margin="0,0,0,8"
                   AutomationProperties.LiveSetting="Polite"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="FindAllBtn" Width="76" Margin="0,0,8,0" Click="FindAll_Click"/>
            <Button x:Name="FindNextBtn" Width="80" Margin="0,0,8,0" IsDefault="True" Click="FindNext_Click"/>
            <Button x:Name="ReplaceBtn" Width="76" Margin="0,0,8,0" Visibility="Collapsed" Click="Replace_Click"/>
            <Button x:Name="ReplaceAllBtn" Width="88" Margin="0,0,8,0" Visibility="Collapsed" Click="ReplaceAll_Click"/>
            <Button x:Name="CloseBtn" Width="60" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
