<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FreeX.Core.Model\FreeX.Core.Model.csproj" />
    <ProjectReference Include="..\FreeX.Core.Formula\FreeX.Core.Formula.csproj" />
    <ProjectReference Include="..\FreeX.Core.Calc\FreeX.Core.Calc.csproj" />
    <ProjectReference Include="..\FreeX.Core.Commands\FreeX.Core.Commands.csproj" />
    <ProjectReference Include="..\FreeX.Core.IO\FreeX.Core.IO.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Ribbon\Free.Shared.Ribbon.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Ribbon.Wpf\Free.Shared.Ribbon.Wpf.csproj" />
    <ProjectReference Include="..\FreeX.Ribbon.Definitions\FreeX.Ribbon.Definitions.csproj" />
    <ProjectReference Include="..\FreeX.App.Services\FreeX.App.Services.csproj" />
    <ProjectReference Include="..\FreeX.App.Presentation\FreeX.App.Presentation.csproj" />
    <ProjectReference Include="..\FreeX.App.UI\FreeX.App.UI.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Shell\Free.Shared.Shell.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Shell.Wpf\Free.Shared.Shell.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="Free.Shared.Ribbon" />
    <Using Include="FreeX.Ribbon.Definitions" />
    <Using Include="FreeX.App.Services.Ribbon" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\FreeX.ico" />
  </ItemGroup>

  <!-- Compile App.xaml as a Page so the WPF SDK does not generate its own Main; the explicit
       entry point in Program.cs runs Velopack before WPF initializes. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup Condition="'$(FreeXTesterReleaseEnglishOnly)' == 'true'">
    <EmbeddedResource Remove="Resources\Strings.*.resx" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="FreeX.Legal.ProjectLicense.txt" />
    <EmbeddedResource Include="..\..\docs\legal\legal-notices.md" LogicalName="FreeX.Legal.LegalNotices.md" />
    <EmbeddedResource Include="..\..\docs\legal\privacy.md" LogicalName="FreeX.Legal.PrivacyNotice.md" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_NOTICES.md" LogicalName="FreeX.Legal.ThirdPartyNotices.md" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_LICENSES.md" LogicalName="FreeX.Legal.ThirdPartyLicenses.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="PDFsharp-WPF" />
    <PackageReference Include="Sentry" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SharpVectors.Wpf" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\FreeX.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- CommandIconsSvg now live in FreeX.Ribbon.Definitions (shared with the Avalonia app) and are
         copied to this app's output transitively at Resources\CommandIconsSvg\ — the same path
         RibbonIconFactory.Svg.cs loads from. -->
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>FreeX.App.Host.Program</StartupObject>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>Resources\FreeX.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ReachFramework provides System.Windows.Xps.* and System.Printing -->
    <UseReachFramework>true</UseReachFramework>
    <Version>0.5.0</Version>
    <InformationalVersion>0.5.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Free.Shared.Opc" />
    <Using Include="Free.Shared.Commands" />
    <Using Include="Free.Shared.AppServices" />
    <Using Include="Free.Shared.Shell" />
  </ItemGroup>
</Project>
