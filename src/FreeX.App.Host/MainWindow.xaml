<Window x:Class="FreeX.App.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:FreeX.App.UI;assembly=FreeX.App.UI"
        xmlns:local="clr-namespace:FreeX.App.Host"
        xmlns:ribbonWpf="clr-namespace:Free.Shared.Ribbon.Wpf;assembly=Free.Shared.Ribbon.Wpf"
        xmlns:presentation="clr-namespace:FreeX.App.Presentation.Shell;assembly=FreeX.App.Presentation"
        xmlns:model="clr-namespace:FreeX.Core.Model;assembly=FreeX.Core.Model"
        mc:Ignorable="d"
        Title="FreeX"
        Icon="Resources/FreeX.ico"
        Height="720" Width="1280"
        WindowState="Maximized"
        Background="{DynamicResource FreeXSheetSurfaceBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        AllowDrop="True"
        DragOver="MainWindow_DragOver"
        Drop="MainWindow_Drop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary Source="Resources/MainWindowResources.xaml"/>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Title / quick-access bar (QAT) -->
            <RowDefinition Height="Auto"/>
            <!-- Ribbon (tab strip + tab content) -->
            <RowDefinition Height="Auto"/>
            <!-- Optional Quick Access Toolbar below the ribbon -->
            <RowDefinition Height="Auto"/>
            <!-- Formula bar -->
            <RowDefinition Height="Auto"/>
            <!-- Spreadsheet grid -->
            <RowDefinition Height="*"/>
            <!-- Sheet tabs -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 0  Title bar / Quick Access Toolbar
             ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="TitleBarRoot" Grid.Row="0" Background="{DynamicResource FreeXTitleBarBrush}" BorderBrush="{DynamicResource FreeXTitleBarBrush}"
                BorderThickness="0,0,0,1" Padding="6,3">
            <DockPanel>
                <!-- App icon -->
                <Border x:Name="TitleBarAppIcon"
                        DockPanel.Dock="Left"
                        Width="22" Height="22"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource FreeXTitleBarBrush}"
                        BorderBrush="{DynamicResource FreeXBorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
                    <Grid SnapsToDevicePixels="True"
                          UseLayoutRounding="True"
                          TextOptions.TextFormattingMode="Display"
                          TextOptions.TextRenderingMode="ClearType"
                          TextOptions.TextHintingMode="Fixed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="TitleBarAppFreeBand"
                                Grid.Row="0"
                                Background="#0F7E9B"
                                CornerRadius="1,1,0,0"
                                Margin="0"/>
                        <TextBlock x:Name="TitleBarAppXOutlineTop"
                                   Grid.Row="0"
                                   Grid.RowSpan="3"
                                   Panel.ZIndex="3"
                                   Text="X"
                                   Foreground="#10253A"
                                   FontFamily="Segoe UI"
                                   FontWeight="Bold"
                                   FontSize="14.5"
                                   Margin="0,-3,0,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="TitleBarAppXOutlineBottom"
                                   Grid.Row="0"
                                   Grid.RowSpan="3"
                                   Panel.ZIndex="3"
                                   Text="X"
                                   Foreground="#10253A"
                                   FontFamily="Segoe UI"
                                   FontWeight="Bold"
                                   FontSize="14.5"
                                   Margin="0,-1,0,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="TitleBarAppXOutlineLeft"
                                   Grid.Row="0"
                                   Grid.RowSpan="3"
                                   Panel.ZIndex="3"
                                   Text="X"
                                   Foreground="#10253A"
                                   FontFamily="Segoe UI"
                                   FontWeight="Bold"
                                   FontSize="14.5"
                                   Margin="-1,-2,0,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="TitleBarAppXOutlineRight"
                                   Grid.Row="0"
                                   Grid.RowSpan="3"
                                   Panel.ZIndex="3"
                                   Text="X"
                                   Foreground="#10253A"
                                   FontFamily="Segoe UI"
                                   FontWeight="Bold"
                                   FontSize="14.5"
                                   Margin="1,-2,0,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="TitleBarAppX"
                                   Grid.Row="0"
                                   Grid.RowSpan="3"
                                   Panel.ZIndex="4"
                                   Text="X"
                                   Foreground="{DynamicResource FreeXWhiteBrush}"
                                   FontFamily="Segoe UI"
                                   FontWeight="Bold"
                                   FontSize="14.5"
                                   Margin="0,-2,0,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock Text="FREE"
                                   Grid.Row="0"
                                   Panel.ZIndex="2"
                                   Foreground="{DynamicResource FreeXWhiteBrush}"
                                   FontFamily="Segoe UI"
                                   FontWeight="Bold"
                                   FontSize="6.6"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </Grid>
                </Border>
                <!-- QAT buttons -->
                <StackPanel x:Name="TitleBarQatPanel"
                            DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                <!-- System buttons — must be docked Right before the fill element -->
                <!-- Order in XAML (Right-docked) is right-to-left, so Close first -->
                <Button x:Name="CloseSysBtn"    DockPanel.Dock="Right"
                        Style="{StaticResource CloseSysBtnStyle}" Click="CloseSysBtn_Click"
                        AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_Close}"
                        AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationName_Close}"
                        AutomationProperties.AutomationId="CloseSysBtn">
                    <local:RibbonIcon Kind="WindowClose" IconSize="18"
                                      Foreground="{DynamicResource FreeXTitleBarForegroundBrush}"/>
                </Button>
                <Button x:Name="MaxRestoreBtn"  DockPanel.Dock="Right"
                        Style="{StaticResource SysBtnStyle}"      Click="MaxRestoreBtn_Click"
                        AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_MaximizeOrRestore}"
                        AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationName_MaximizeOrRestore}"
                        AutomationProperties.AutomationId="MaxRestoreBtn">
                    <local:RibbonIcon x:Name="MaxRestoreIcon" Kind="WindowMaximize" IconSize="18"
                                      Foreground="{DynamicResource FreeXTitleBarForegroundBrush}"/>
                </Button>
                <Button x:Name="MinimizeBtn"    DockPanel.Dock="Right"
                        Style="{StaticResource SysBtnStyle}"      Click="MinimizeBtn_Click"
                        AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_Minimize}"
                        AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationName_Minimize}"
                        AutomationProperties.AutomationId="MinimizeBtn">
                    <local:RibbonIcon Kind="WindowMinimize" IconSize="18"
                                      Foreground="{DynamicResource FreeXTitleBarForegroundBrush}"/>
                </Button>
                <!-- Workbook name centred -->
                <TextBlock x:Name="WorkbookNameText"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource FreeXTitleBarForegroundBrush}" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 1  Ribbon  (tabbed, groups with labels)
             ═══════════════════════════════════════════════════════════════ -->
        <TabControl x:Name="RibbonTabs" Grid.Row="1" Background="{DynamicResource FreeXRibbonSurfaceBrush}"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource FreeXBorderBrush}"
                    Padding="0" TabStripPlacement="Top" SelectedIndex="1" MinHeight="132"
                    Focusable="True" IsTabStop="True"
                    KeyboardNavigation.TabNavigation="Continue"
                    KeyboardNavigation.ControlTabNavigation="Continue"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    SelectionChanged="RibbonTabs_SelectionChanged">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>
        </TabControl>

        <Border x:Name="BelowRibbonQatRoot"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="{DynamicResource FreeXRibbonSurfaceBrush}"
                BorderBrush="{DynamicResource FreeXBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,2">
            <StackPanel x:Name="BelowRibbonQatPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"/>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 2  Formula bar
             ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="FormulaBarBorder" Grid.Row="3" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Background="White" Padding="4,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="CellAddressBox" Grid.Column="0" Text="A1"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          StaysOpenOnEdit="True"
                          MaxDropDownHeight="220"
                          FontFamily="Consolas" FontSize="15"
                          MinHeight="30"
                          TextOptions.TextFormattingMode="Display"
                          TextOptions.TextRenderingMode="ClearType"
                          TextOptions.TextHintingMode="Fixed"
                          VerticalContentAlignment="Center"
                          BorderBrush="#C0C0C0" Padding="5,3"
                          AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_NameBox}"
                          AutomationProperties.AutomationId="CellAddressBox"
                          AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationHelpText_GoToACellOrNamedRange}"
                          DropDownOpened="CellAddressBox_DropDownOpened"
                          SelectionChanged="CellAddressBox_SelectionChanged"
                          KeyDown="CellAddressBox_KeyDown"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,2,0">
                    <Button x:Name="FormulaBarCancelButton"
                            Width="22" Height="22"
                            Background="Transparent" BorderThickness="0"
                            Padding="0" Margin="0,0,1,0" Cursor="Hand"
                            Click="FormulaBarCancelButton_Click"
                            AutomationProperties.Name="{local:Loc Key=MainWindow_TooltipTitle_CancelFormulaBarEdit}"
                            AutomationProperties.HelpText="{local:Loc Key=MainWindow_TooltipDescription_CancelFormulaBarEdit}"
                            AutomationProperties.AutomationId="FormulaBarCancelButton"
                            ribbonWpf:RibbonTooltip.Title="{local:Loc Key=MainWindow_TooltipTitle_CancelFormulaBarEdit}"
                            ribbonWpf:RibbonTooltip.KeyTip="FC"
                            ribbonWpf:RibbonTooltip.Description="{local:Loc Key=MainWindow_TooltipDescription_CancelFormulaBarEdit}"
                            ribbonWpf:RibbonMetadata.CommandName="Cancel Formula Bar Edit">
                        <Path Data="M4,4 L12,12 M12,4 L4,12"
                              Width="16" Height="16"
                              Stroke="#C00000"
                              StrokeThickness="1.55"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="FormulaBarEnterButton"
                            Width="22" Height="22"
                            Background="Transparent" BorderThickness="0"
                            Padding="0" Margin="0,0,3,0" Cursor="Hand"
                            Click="FormulaBarEnterButton_Click"
                            AutomationProperties.Name="{local:Loc Key=MainWindow_TooltipTitle_EnterFormulaBarEdit}"
                            AutomationProperties.HelpText="{local:Loc Key=MainWindow_TooltipDescription_EnterFormulaBarEdit}"
                            AutomationProperties.AutomationId="FormulaBarEnterButton"
                            ribbonWpf:RibbonTooltip.Title="{local:Loc Key=MainWindow_TooltipTitle_EnterFormulaBarEdit}"
                            ribbonWpf:RibbonTooltip.KeyTip="FE"
                            ribbonWpf:RibbonTooltip.Description="{local:Loc Key=MainWindow_TooltipDescription_EnterFormulaBarEdit}"
                            ribbonWpf:RibbonMetadata.CommandName="Enter Formula Bar Edit">
                        <Path Data="M3,8 L6,11 L13,4"
                              Width="16" Height="16"
                              Stroke="#008000"
                              StrokeThickness="1.65"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Stretch="Uniform"/>
                    </Button>

                    <!-- fx button opens Insert Function dialog -->
                    <Button x:Name="FormulaBarFxButton"
                            Content="{local:Loc Key=MainWindow_Content_Fx}" FontWeight="Bold" Foreground="#444"
                            Background="Transparent" BorderThickness="0"
                            Padding="2,0" VerticalAlignment="Center" Margin="0" Cursor="Hand"
                            FontSize="12" FontStyle="Italic"
                            Click="InsertFunctionBtn_Click"
                            ribbonWpf:RibbonTooltip.Title="{local:Loc Key=MainWindow_TooltipTitle_InsertFunction}"
                            ribbonWpf:RibbonTooltip.KeyTip="FX"
                            ribbonWpf:RibbonTooltip.Description="{local:Loc Key=MainWindow_TooltipDescription_SearchForAndInsertAFunctionIntoTheSelectedCell}" ribbonWpf:RibbonMetadata.CommandName="Insert Function"/>
                </StackPanel>

                <Grid Grid.Column="2">
                    <TextBlock x:Name="FormulaBarReferenceOverlay"
                               Margin="7,3,5,2"
                               FontFamily="Calibri"
                               FontSize="18"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType"
                               TextOptions.TextHintingMode="Fixed"/>
                    <TextBox x:Name="FormulaBar" FontFamily="Calibri" FontSize="18"
                             MinHeight="30"
                             TextOptions.TextFormattingMode="Display"
                             TextOptions.TextRenderingMode="ClearType"
                             TextOptions.TextHintingMode="Fixed"
                             AcceptsReturn="True"
                             Background="Transparent"
                             CaretBrush="Black"
                             VerticalContentAlignment="Center" BorderBrush="#C0C0C0" Padding="6,3"
                             AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_FormulaBar}"
                             AutomationProperties.AutomationId="FormulaBar"
                             AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationHelpText_EditTheActiveCellValueOrFormula}"
                             PreviewKeyDown="FormulaBar_KeyDown"/>
                </Grid>

                <!-- Expand/collapse chevron -->
                <Button x:Name="FormulaBarExpandBtn" Grid.Column="3"
                        Width="18" Height="18"
                        Background="Transparent" BorderThickness="0"
                        Padding="0" Margin="2,0,0,0"
                        VerticalAlignment="Top" Cursor="Hand"
                        Click="FormulaBarExpandBtn_Click"
                        AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_ExpandFormulaBar}"
                        AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationHelpText_ExpandTheFormulaBarToAMultiLineEditor}"
                        AutomationProperties.AutomationId="FormulaBarExpandBtn"
                        ribbonWpf:RibbonTooltip.Title="{local:Loc Key=MainWindow_TooltipTitle_ExpandFormulaBar}"
                        ribbonWpf:RibbonTooltip.KeyTip="BX"
                        ribbonWpf:RibbonTooltip.Description="{local:Loc Key=MainWindow_TooltipDescription_ExpandTheFormulaBarToAMultiLineEditor}" ribbonWpf:RibbonMetadata.CommandName="Expand Formula Bar">
                    <Path Data="M2,2 L6,6 L10,2"
                          Width="12" Height="8"
                          Stroke="#1F1F1F"
                          StrokeThickness="1.45"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 3  Spreadsheet grid
             ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="WorkbookWorkAreaRoot" Grid.Row="4" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" ClipToBounds="True">
                <ui:GridView x:Name="SheetGrid"
                             AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_Worksheet}"
                             AutomationProperties.AutomationId="SheetGrid"
                             AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationHelpText_SpreadsheetGridUseArrowKeysToNavigateCellsF2ToEditAndTabEnterToMoveFocus}"
                             CommentOverlayHost="{Binding ElementName=CommentOverlay}"/>
                <!-- Inline cell edit overlay: a Canvas with a positioned TextBox -->
                <Canvas x:Name="EditOverlay"
                        IsHitTestVisible="False" Panel.ZIndex="20"/>
                <Canvas x:Name="CommentOverlay"
                        ClipToBounds="True"
                        Panel.ZIndex="30"/>
                <!-- Full-window chartsheet host: shown instead of the grid when the active sheet
                     is a chartsheet (a chart-only sheet with no cell grid). -->
                <Image x:Name="ChartsheetView"
                       Visibility="Collapsed"
                       Panel.ZIndex="40"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       AutomationProperties.AutomationId="ChartsheetView"
                       AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_Worksheet}"
                       SizeChanged="ChartsheetView_SizeChanged"/>
            </Grid>

            <ScrollBar x:Name="VerticalScroll" Grid.Column="1"
                       Orientation="Vertical" Minimum="1" Maximum="1000000" Value="1" SmallChange="1"
                       AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_VerticalWorksheetScrollBar}"
                       AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationHelpText_ScrollWorksheetRows}"/>

            <Border x:Name="PivotFieldListPane"
                    Grid.Column="2"
                    Width="320"
                    Background="#F7F7F7"
                    BorderBrush="#C8C8C8"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed"
                    AllowDrop="True"
                    DragOver="PivotFieldListRemoveZone_DragOver"
                    Drop="PivotFieldListRemoveZone_Drop"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_PivotTableFields}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0.85*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.25*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Button x:Name="PivotFieldListCloseBtn"
                                Content="X"
                                Width="22"
                                Height="22"
                                DockPanel.Dock="Right"
                                Padding="0"
                                Click="PivotFieldListCloseBtn_Click"
                                AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_ClosePivotTableFields}" ribbonWpf:RibbonMetadata.CommandName="X"/>
                        <TextBlock Text="{local:Loc Key=MainWindow_Text_PivotTableFields}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1"
                               Text="{local:Loc Key=MainWindow_Text_ChooseFieldsToAddToReport}"
                               FontSize="12"
                               Margin="0,8,0,3"/>
                    <TextBox x:Name="PivotFieldListSearchBox"
                             Grid.Row="2"
                             Height="24"
                             Margin="0,0,0,4"
                             VerticalContentAlignment="Center"
                             TextChanged="PivotFieldListSearchBox_TextChanged"
                             AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_SearchPivotTableFields}"/>
                    <ListBox x:Name="PivotAvailableFieldsList"
                             Grid.Row="3"
                             MinHeight="96"
                             SelectionMode="Single"
                             AllowDrop="True"
                             Loaded="PivotFieldList_Loaded"
                             PreviewMouseMove="PivotFieldList_PreviewMouseMove"
                             PreviewMouseRightButtonDown="PivotFieldList_PreviewMouseRightButtonDown"
                             GiveFeedback="PivotFieldList_GiveFeedback"
                             DragOver="PivotFieldList_DragOver"
                             Drop="PivotFieldList_Drop"
                             AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_AvailablePivotTableFields}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Caption}"
                                          IsChecked="{Binding IsChecked}"
                                          Click="PivotAvailableFieldCheckBox_Click"
                                          ribbonWpf:RibbonTooltip.Title="{Binding Caption}"
                                          ribbonWpf:RibbonTooltip.KeyTip="F"
                                          ribbonWpf:RibbonTooltip.Description="{local:Loc Key=MainWindow_TooltipDescription_AddOrRemoveThisFieldFromTheActivePivotTableLayout}"
                                          AutomationProperties.Name="{Binding Caption}" ribbonWpf:RibbonMetadata.CommandName="{Binding Caption}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="4" Margin="0,6,0,6">
                        <UniformGrid Columns="5">
                            <Button Content="{local:Loc Key=MainWindow_Content_Rows}" Click="PivotFieldToRowsBtn_Click" Margin="1" MinHeight="24" AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_AddSelectedPivotTableFieldToRows}" ribbonWpf:RibbonMetadata.CommandName="Rows"/>
                            <Button Content="{local:Loc Key=MainWindow_Content_Columns}" Click="PivotFieldToColumnsBtn_Click" Margin="1" MinHeight="24" AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_AddSelectedPivotTableFieldToColumns}" ribbonWpf:RibbonMetadata.CommandName="Columns"/>
                            <Button Content="{local:Loc Key=MainWindow_Content_Values}" Click="PivotFieldToValuesBtn_Click" Margin="1" MinHeight="24" AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_AddSelectedPivotTableFieldToValues}" ribbonWpf:RibbonMetadata.CommandName="Values"/>
                            <Button Content="{local:Loc Key=MainWindow_Content_Filters}" Click="PivotFieldToFiltersBtn_Click" Margin="1" MinHeight="24" AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_AddSelectedPivotTableFieldToFilters}" ribbonWpf:RibbonMetadata.CommandName="Filters"/>
                            <Button Content="{local:Loc Key=MainWindow_Content_Remove}" Click="PivotFieldRemoveBtn_Click" Margin="1" MinHeight="24"
                                    AllowDrop="True"
                                    DragOver="PivotFieldRemoveDropZone_DragOver"
                                    Drop="PivotFieldRemoveDropZone_Drop"
                                    AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_RemoveSelectedPivotTableField}" ribbonWpf:RibbonMetadata.CommandName="Remove"/>
                        </UniformGrid>
                        <DockPanel Margin="0,6,0,0" LastChildFill="False">
                            <CheckBox x:Name="PivotFieldListDeferLayoutCheckBox"
                                      Content="{local:Loc Key=MainWindow_Content_DeferLayoutUpdate}"
                                      VerticalAlignment="Center"
                                      DockPanel.Dock="Left"
                                      Click="PivotFieldListDeferLayoutCheckBox_Click"
                                      ribbonWpf:RibbonTooltip.Title="{local:Loc Key=MainWindow_TooltipTitle_DeferLayoutUpdate}"
                                      ribbonWpf:RibbonTooltip.Description="{local:Loc Key=MainWindow_TooltipDescription_QueuePivotTableFieldLayoutChangesUntilYouChooseUpdate}"
                                      ribbonWpf:RibbonTooltip.KeyTip="DU"
                                      AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_DeferPivotTableLayoutUpdate}" ribbonWpf:RibbonMetadata.CommandName="Defer Layout Update"/>
                            <Button x:Name="PivotFieldListUpdateBtn"
                                    Content="{local:Loc Key=MainWindow_Content_Update}"
                                    MinWidth="72"
                                    MinHeight="24"
                                    DockPanel.Dock="Right"
                                    Click="PivotFieldListUpdateBtn_Click"
                                    AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_UpdatePivotTableLayout}" ribbonWpf:RibbonMetadata.CommandName="Update"/>
                        </DockPanel>
                    </StackPanel>

                    <Grid Grid.Row="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Loc Key=MainWindow_Text_Filters}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{local:Loc Key=MainWindow_Text_Columns}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ListBox x:Name="PivotFiltersList"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 MinHeight="80"
                                 SelectionMode="Single"
                                 AllowDrop="True"
                                 Loaded="PivotFieldList_Loaded"
                                 PreviewMouseMove="PivotFieldList_PreviewMouseMove"
                                 PreviewMouseRightButtonDown="PivotFieldList_PreviewMouseRightButtonDown"
                                 GiveFeedback="PivotFieldList_GiveFeedback"
                                 DragOver="PivotFieldList_DragOver"
                                 Drop="PivotFieldList_Drop"
                                 AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_PivotTableFiltersArea}">
                        </ListBox>
                        <ListBox x:Name="PivotColumnsList"
                                 Grid.Row="1"
                                 Grid.Column="2"
                                 MinHeight="80"
                                 SelectionMode="Single"
                                 AllowDrop="True"
                                 Loaded="PivotFieldList_Loaded"
                                 PreviewMouseMove="PivotFieldList_PreviewMouseMove"
                                 PreviewMouseRightButtonDown="PivotFieldList_PreviewMouseRightButtonDown"
                                 GiveFeedback="PivotFieldList_GiveFeedback"
                                 DragOver="PivotFieldList_DragOver"
                                 Drop="PivotFieldList_Drop"
                                 AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_PivotTableColumnsArea}">
                        </ListBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Loc Key=MainWindow_Text_Rows}" FontWeight="SemiBold" Margin="0,8,0,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{local:Loc Key=MainWindow_Text_Values}" FontWeight="SemiBold" Margin="0,8,0,3"/>
                        <ListBox x:Name="PivotRowsList"
                                 Grid.Row="3"
                                 Grid.Column="0"
                                 MinHeight="80"
                                 SelectionMode="Single"
                                 AllowDrop="True"
                                 Loaded="PivotFieldList_Loaded"
                                 PreviewMouseMove="PivotFieldList_PreviewMouseMove"
                                 PreviewMouseRightButtonDown="PivotFieldList_PreviewMouseRightButtonDown"
                                 GiveFeedback="PivotFieldList_GiveFeedback"
                                 DragOver="PivotFieldList_DragOver"
                                 Drop="PivotFieldList_Drop"
                                 AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_PivotTableRowsArea}">
                        </ListBox>
                        <ListBox x:Name="PivotValuesList"
                                 Grid.Row="3"
                                 Grid.Column="2"
                                 MinHeight="80"
                                 SelectionMode="Single"
                                 AllowDrop="True"
                                 Loaded="PivotFieldList_Loaded"
                                 PreviewMouseMove="PivotFieldList_PreviewMouseMove"
                                 PreviewMouseRightButtonDown="PivotFieldList_PreviewMouseRightButtonDown"
                                 GiveFeedback="PivotFieldList_GiveFeedback"
                                 DragOver="PivotFieldList_DragOver"
                                 Drop="PivotFieldList_Drop"
                                 AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_PivotTableValuesArea}">
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="SlicerTimelinePane"
                    Grid.Column="3"
                    Width="280"
                    Background="#FFFFFF"
                    BorderBrush="#C8C8C8"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_SlicersAndTimelines}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                            <Button x:Name="SlicerTimelinePaneCloseBtn"
                                    Content="X"
                                    Width="22"
                                    Height="22"
                                    DockPanel.Dock="Right"
                                    Padding="0"
                                    Click="SlicerTimelinePaneCloseBtn_Click"
                                    AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_CloseSlicersAndTimelines}" ribbonWpf:RibbonMetadata.CommandName="X"/>
                            <TextBlock Text="{local:Loc Key=MainWindow_Text_SlicersAndTimelines}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <ItemsControl x:Name="SlicerItemsControl"
                                      AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_WorkbookSlicers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="8">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasActiveFilter}" Value="True">
                                                        <Setter Property="Background" Value="#F7FBFF"/>
                                                        <Setter Property="BorderBrush" Value="#5B9BD5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding FieldName}" FontSize="11" Foreground="#666" Margin="0,1,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Tiles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Caption}"
                                                                Tag="{Binding SlicerName}"
                                                                Click="SlicerTileButton_Click"
                                                                MinHeight="24"
                                                                Margin="0,1"
                                                                Padding="6,2"
                                                                HorizontalContentAlignment="Left"
                                                                AutomationProperties.Name="{Binding Caption}">
                                                            <Button.Style>
                                                                <Style TargetType="{x:Type Button}">
                                                                    <Setter Property="Background" Value="#5B9BD5"/>
                                                                    <Setter Property="BorderBrush" Value="#4178B8"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                                            <Setter Property="Background" Value="#F2F2F2"/>
                                                                            <Setter Property="BorderBrush" Value="#C8C8C8"/>
                                                                            <Setter Property="Foreground" Value="#666666"/>
                                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#2B579A"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="{local:Loc Key=MainWindow_Content_ClearFilter}"
                                                    Tag="{Binding Name}"
                                                    Click="SlicerClearButton_Click"
                                                    IsEnabled="{Binding HasActiveFilter}"
                                                    Margin="0,6,0,0"
                                                    MinHeight="24"
                                                    AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_ClearSlicerFilter}" ribbonWpf:RibbonMetadata.CommandName="Clear Filter"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl x:Name="TimelineItemsControl"
                                      AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_WorkbookTimelines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="8">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasActiveFilter}" Value="True">
                                                        <Setter Property="Background" Value="#F7FBFF"/>
                                                        <Setter Property="BorderBrush" Value="#5B9BD5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding FieldName}" FontSize="11" Foreground="#666" Margin="0,1,0,6"/>
                                            <UniformGrid Columns="2">
                                                <TextBox x:Name="TimelineStartBox" Text="{Binding SelectedStartDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,3,0"/>
                                                <TextBox x:Name="TimelineEndBox" Text="{Binding SelectedEndDate, UpdateSourceTrigger=PropertyChanged}" Margin="3,0,0,0"/>
                                            </UniformGrid>
                                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                                <Button Content="{local:Loc Key=MainWindow_Content_Apply}" Click="TimelineApplyButton_Click" MinHeight="24" Margin="0,0,3,0"
                                                        AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_ApplyTimelineFilter}" ribbonWpf:RibbonMetadata.CommandName="Apply"/>
                                                <Button Content="{local:Loc Key=MainWindow_Content_Clear}" Click="TimelineClearButton_Click" MinHeight="24" Margin="3,0,0,0"
                                                        IsEnabled="{Binding HasActiveFilter}"
                                                        AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_ClearTimelineFilter}" ribbonWpf:RibbonMetadata.CommandName="Clear"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 4  Sheet tabs
             ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="SheetTabsPanelRoot" Grid.Row="5" Panel.ZIndex="5" Background="{DynamicResource FreeXSheetSurfaceBrush}" BorderBrush="{DynamicResource FreeXBorderBrush}"
                BorderThickness="0" Padding="0">
            <Grid x:Name="SheetTabsRowGrid"
                  MinHeight="28"
                  Background="{DynamicResource FreeXSheetSurfaceBrush}"
                  SizeChanged="SheetTabsRowGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="SheetTabsLeadingSpacer" Grid.Column="0"
                        Width="{Binding ActualRowHeaderWidth, ElementName=SheetGrid}"
                        Height="28"
                        Margin="0"
                        VerticalAlignment="Top"
                        Panel.ZIndex="4"
                        Background="{DynamicResource FreeXSheetSurfaceBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        IsHitTestVisible="False"/>

                <Canvas x:Name="SheetTabsChromeLayer"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Height="28"
                        Margin="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Panel.ZIndex="1"
                        ClipToBounds="False"
                        SnapsToDevicePixels="True"
                        IsHitTestVisible="False"/>

                <Button x:Name="SheetNavLeftBtn" Grid.Column="0" Width="28" Height="26" Padding="0"
                        FontSize="13" Background="{DynamicResource FreeXSheetSurfaceBrush}" BorderBrush="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource FreeXAccentDarkBrush}"
                        Cursor="Hand" Click="SheetNavLeftBtn_Click" Loaded="SheetNavButton_Loaded" PreviewMouseDown="SheetNavButton_MouseRightButtonDown" PreviewMouseRightButtonDown="SheetNavButton_MouseRightButtonDown" MouseRightButtonDown="SheetNavButton_MouseRightButtonDown" PreviewMouseRightButtonUp="SheetNavButton_MouseRightButtonUp" MouseRightButtonUp="SheetNavButton_MouseRightButtonUp" ContextMenuOpening="SheetNavButton_ContextMenuOpening" Visibility="Hidden" Margin="0,1,0,0"
                        HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                        VerticalAlignment="Top" VerticalContentAlignment="Center"
                        Panel.ZIndex="9"
                        AutomationProperties.Name="{local:Loc Key=MainWindow_TooltipTitle_ScrollTabsLeft}"
                        AutomationProperties.AutomationId="SheetNavLeftBtn"
                        ribbonWpf:RibbonTooltip.Title="{local:Loc Key=MainWindow_TooltipTitle_ScrollTabsLeft}"
                        ribbonWpf:RibbonTooltip.KeyTip="SL"
                        ribbonWpf:RibbonTooltip.Description="{local:Loc Key=MainWindow_TooltipDescription_ScrollTheSheetTabListToTheLeft}" ribbonWpf:RibbonMetadata.CommandName="Scroll Tabs Left">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="NavHitArea"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True">
                                </ContentPresenter>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavHitArea" Property="Background" Value="#E6F6FA"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="NavHitArea" Property="Background" Value="#CCEAF2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid Width="14" Height="14" SnapsToDevicePixels="True">
                        <Path Data="M 9,1 L 5,5 L 9,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.75"
                              StrokeStartLineCap="Square"
                              StrokeEndLineCap="Square"
                              StrokeLineJoin="Miter"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- Sheet tabs in a clipped, scrollbar-free viewport -->
                <ScrollViewer x:Name="SheetTabsScroller" Grid.Column="1"
                              Grid.ColumnSpan="4"
                              Height="28"
                              MinHeight="28"
                              Margin="0"
                              Panel.ZIndex="3"
                              ClipToBounds="True"
                              HorizontalAlignment="Left"
                              FocusVisualStyle="{x:Null}"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              ScrollChanged="SheetTabsScroller_ScrollChanged"
                              SizeChanged="SheetTabsScroller_SizeChanged"
                              Loaded="SheetTabsScroller_Loaded">
                    <StackPanel x:Name="SheetTabsScrollableContent"
                                Orientation="Horizontal"
                                ClipToBounds="False">
                        <ItemsControl x:Name="SheetTabsControl"
                                      FocusVisualStyle="{x:Null}"
                                      Panel.ZIndex="4">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Panel.ZIndex" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGrouped}" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="10"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="TabChrome"
                                          Cursor="Hand"
                                          Focusable="True"
                                          AutomationProperties.Name="{Binding AutomationName}"
                                          AutomationProperties.AutomationId="{Binding Name}"
                                          AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationHelpText_SelectThisSheetRightClickOrPressShiftF10ForSheetTabOptions}"
                                          FocusVisualStyle="{x:Null}"
                                          MouseLeftButtonDown="SheetTab_MouseLeftButtonDown"
                                          MouseMove="SheetTab_MouseMove"
                                          MouseLeftButtonUp="SheetTab_MouseLeftButtonUp"
                                          LostMouseCapture="SheetTab_LostMouseCapture"
                                          MouseRightButtonDown="SheetTab_MouseRightButtonDown"
                                          Loaded="SheetTabChrome_Loaded">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Margin"       Value="-16,0,0,1"/>
                                                <Setter Property="Panel.ZIndex" Value="0"/>
                                                <Setter Property="MinHeight"    Value="27"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGrouped}" Value="True">
                                                        <Setter Property="Margin"       Value="-16,0,0,1"/>
                                                        <Setter Property="Panel.ZIndex" Value="5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Margin"       Value="-16,0,0,1"/>
                                                        <Setter Property="Panel.ZIndex" Value="10"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border x:Name="TabBorder"
                                                CornerRadius="0,0,4,4" Padding="12,4,12,0"
                                                Margin="8,0,8,0"
                                                Panel.ZIndex="2"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <Grid>
                                                <Grid MouseDown="SheetTab_LabelMouseDown">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="0"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel x:Name="SheetTabLabelContent"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Viewbox x:Name="ProtectedSheetLockIcon"
                                                                 Width="10"
                                                                 Height="11"
                                                                 Margin="0,1,5,0"
                                                                 VerticalAlignment="Center"
                                                                 IsHitTestVisible="False"
                                                                 AutomationProperties.Name="{local:Loc Key=SheetTab_ProtectedSheetIconAutomationName}">
                                                            <Viewbox.Style>
                                                                <Style TargetType="Viewbox">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Viewbox.Style>
                                                            <Grid Width="12" Height="12">
                                                                <Path Data="M 3.7 5.2 V 4.1 C 3.7 2.1 5 0.9 6.5 0.9 C 8 0.9 9.3 2.1 9.3 4.1 V 5.2"
                                                                      Stroke="{DynamicResource FreeXAccentDarkBrush}"
                                                                      StrokeThickness="1.35"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round"/>
                                                                <Path Data="M 2.2 5 H 10.8 V 11 H 2.2 Z"
                                                                      Fill="{DynamicResource FreeXAccentDarkBrush}"/>
                                                            </Grid>
                                                        </Viewbox>
                                                        <TextBlock x:Name="SheetTabNameText"
                                                                   Text="{Binding Name}"
                                                                   FontSize="13"
                                                                   FontFamily="Segoe UI"
                                                                   AutomationProperties.Name="{Binding AutomationName}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="TabFocusCue"
                                                Margin="14,3,14,4"
                                                BorderBrush="{DynamicResource FreeXAccentDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Panel.ZIndex="8"
                                                Visibility="Collapsed"
                                                IsHitTestVisible="False"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsActive}" Value="False"/>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=TabChrome}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="TabBorder" Property="Background" Value="#E6F6FA"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsActive}" Value="False"/>
                                                <Condition Binding="{Binding IsMouseCaptureWithin, ElementName=TabChrome}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="TabBorder" Property="Background" Value="#CCEAF2"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TabChrome}" Value="True">
                                            <Setter TargetName="TabFocusCue" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AddSheetButton" Content="+" Width="44" MinWidth="44" Height="27" MinHeight="27"
                                FontSize="16" FontWeight="SemiBold" Margin="0,0,0,1" Padding="0"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource FreeXAccentBrush}" Opacity="1"
                                VerticalAlignment="Top" Cursor="Hand"
                                Panel.ZIndex="3"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_InsertSheet}"
                                AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationHelpText_AddANewSheetToTheWorkbook}"
                                Click="AddSheetButton_Click"
                                Loaded="SheetTabsScroller_Loaded"
                                SizeChanged="SheetTabsScroller_SizeChanged"
                                ribbonWpf:RibbonTooltip.Title="{local:Loc Key=MainWindow_TooltipTitle_InsertSheet}"
                                ribbonWpf:RibbonTooltip.KeyTip="IS"
                                ribbonWpf:RibbonTooltip.Description="{local:Loc Key=MainWindow_TooltipDescription_AddANewSheetToTheWorkbook}" ribbonWpf:RibbonMetadata.CommandName="Insert Sheet">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent"
                                          Opacity="{TemplateBinding Opacity}">
                                        <Border x:Name="AddSheetHitVisual"
                                                Width="44"
                                                Height="27"
                                                Background="Transparent"
                                                CornerRadius="0,0,4,4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                SnapsToDevicePixels="True">
                                            <TextBlock Text="+"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       LineHeight="18"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="AddSheetHitVisual" Property="Background" Value="#E6F6FA"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="AddSheetHitVisual" Property="Background" Value="#CCEAF2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border x:Name="SheetTabsTrailingViewportReserve"
                                Width="28"
                                Height="28"
                                Background="Transparent"
                                IsHitTestVisible="False"/>
                    </StackPanel>
                </ScrollViewer>

                <Canvas x:Name="SheetTabsOverlayLayer"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Height="28"
                        Margin="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Panel.ZIndex="6"
                        ClipToBounds="False"
                        SnapsToDevicePixels="True"
                        IsHitTestVisible="False"/>

                <Button x:Name="SheetNavRightBtn" Grid.Column="3"
                        Width="28" Height="26" Padding="0"
                        FontSize="13" Background="{DynamicResource FreeXSheetSurfaceBrush}" BorderBrush="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource FreeXAccentDarkBrush}"
                        Cursor="Hand" Click="SheetNavRightBtn_Click" Loaded="SheetNavButton_Loaded" PreviewMouseDown="SheetNavButton_MouseRightButtonDown" PreviewMouseRightButtonDown="SheetNavButton_MouseRightButtonDown" MouseRightButtonDown="SheetNavButton_MouseRightButtonDown" PreviewMouseRightButtonUp="SheetNavButton_MouseRightButtonUp" MouseRightButtonUp="SheetNavButton_MouseRightButtonUp" ContextMenuOpening="SheetNavButton_ContextMenuOpening" Visibility="Hidden" Margin="0,1,0,0"
                        HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                        VerticalAlignment="Top" VerticalContentAlignment="Center"
                        Panel.ZIndex="9"
                        AutomationProperties.Name="{local:Loc Key=MainWindow_TooltipTitle_ScrollTabsRight}"
                        AutomationProperties.AutomationId="SheetNavRightBtn"
                        ribbonWpf:RibbonTooltip.Title="{local:Loc Key=MainWindow_TooltipTitle_ScrollTabsRight}"
                        ribbonWpf:RibbonTooltip.KeyTip="SR"
                        ribbonWpf:RibbonTooltip.Description="{local:Loc Key=MainWindow_TooltipDescription_ScrollTheSheetTabListToTheRight}" ribbonWpf:RibbonMetadata.CommandName="Scroll Tabs Right">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="NavHitArea"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True">
                                </ContentPresenter>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavHitArea" Property="Background" Value="#E6F6FA"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="NavHitArea" Property="Background" Value="#CCEAF2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid Width="14" Height="14" SnapsToDevicePixels="True">
                        <Path Data="M 5,1 L 9,5 L 5,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.75"
                              StrokeStartLineCap="Square"
                              StrokeEndLineCap="Square"
                              StrokeLineJoin="Miter"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- Horizontal scrollbar (Excel-style, right of sheet tabs) -->
                <ScrollBar x:Name="HorizontalScroll" Grid.Column="5"
                           Orientation="Horizontal" Minimum="1" Maximum="16384" Value="1"
                           SmallChange="1" VerticalAlignment="Center" Margin="0"
                           MinWidth="0"
                           AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_HorizontalWorksheetScrollBar}"
                           AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationHelpText_ScrollWorksheetColumns}"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 5  Status bar
             ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="StatusBarRoot" Grid.Row="6" Panel.ZIndex="6" Background="{DynamicResource FreeXStatusSurfaceBrush}" Padding="8,3"
                AutomationProperties.AutomationId="StatusBarRoot"
                Loaded="StatusBarRoot_Loaded"
                ClipToBounds="True">
            <Grid x:Name="StatusBarGrid" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="StatusModePanel" Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="StatusReadyText" Text="{local:Loc Key=MainWindow_Text_Ready}" Foreground="White"
                               FontSize="{DynamicResource FreeXStatusBarTextFontSize}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusPageNumberText" Text="" Foreground="White"
                               FontSize="{DynamicResource FreeXStatusBarTextFontSize}" VerticalAlignment="Center" Margin="16,0,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <Border x:Name="StatusStatsViewport" Grid.Column="1"
                        Margin="8,0,12,0"
                        ClipToBounds="True">
                    <Grid ClipToBounds="True">
                        <StackPanel x:Name="StatusSaveProgressPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    MaxWidth="460"
                                    ClipToBounds="True">
                            <ProgressBar x:Name="StatusSaveProgressBar"
                                         Width="120" Height="5"
                                         Minimum="0" Maximum="100"
                                         Foreground="#D8EEF6"
                                         Background="#24445E"
                                         BorderThickness="0"
                                         AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_SavingProgress}"/>
                            <TextBlock x:Name="StatusSaveProgressText"
                                       Foreground="White" FontSize="{DynamicResource FreeXStatusBarTextFontSize}"
                                       Margin="8,0,0,0"
                                       MaxWidth="280"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="StatusSaveProgressText"
                                       AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_OpenProgressDetail}"
                                       AutomationProperties.LiveSetting="Assertive"/>
                            <Button x:Name="StatusSaveProgressCancelButton"
                                    Content="{local:Loc Key=Common_Cancel}"
                                    Visibility="Collapsed"
                                    Margin="8,0,0,0"
                                    Padding="8,0"
                                    MinWidth="56"
                                    Height="20"
                                    FontSize="11"
                                    Click="CancelFileOperation_Click"
                                    AutomationProperties.AutomationId="StatusSaveProgressCancelButton"
                                    AutomationProperties.Name="{local:Loc Key=Common_Cancel}"/>
                        </StackPanel>
                        <StackPanel x:Name="StatusStatsPanel" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    ClipToBounds="True">
                            <TextBlock x:Name="StatusAvgText" Foreground="White" FontSize="{DynamicResource FreeXStatusBarTextFontSize}"
                                       AutomationProperties.AutomationId="StatusAvgText"
                                       AutomationProperties.Name="{local:Loc Key=StatusBar_Average}"
                                       AutomationProperties.LiveSetting="Polite"
                                       Margin="0,0,16,0" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="StatusCountText" Foreground="White" FontSize="{DynamicResource FreeXStatusBarTextFontSize}"
                                       AutomationProperties.AutomationId="StatusCountText"
                                       AutomationProperties.Name="{local:Loc Key=StatusBar_Count}"
                                       AutomationProperties.LiveSetting="Polite"
                                       Margin="0,0,16,0" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="StatusNumericalCountText" Foreground="White" FontSize="{DynamicResource FreeXStatusBarTextFontSize}"
                                       AutomationProperties.AutomationId="StatusNumericalCountText"
                                       AutomationProperties.Name="{local:Loc Key=StatusBar_NumericalCount}"
                                       AutomationProperties.LiveSetting="Polite"
                                       Margin="0,0,16,0" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="StatusSumText" Foreground="White" FontSize="{DynamicResource FreeXStatusBarTextFontSize}"
                                       AutomationProperties.AutomationId="StatusSumText"
                                       AutomationProperties.Name="{local:Loc Key=StatusBar_Sum}"
                                       AutomationProperties.LiveSetting="Polite"
                                       Margin="0,0,16,0" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="StatusMinText" Foreground="White" FontSize="{DynamicResource FreeXStatusBarTextFontSize}"
                                       AutomationProperties.AutomationId="StatusMinText"
                                       AutomationProperties.Name="{local:Loc Key=StatusBar_Minimum}"
                                       AutomationProperties.LiveSetting="Polite"
                                       Margin="0,0,16,0" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="StatusMaxText" Foreground="White" FontSize="{DynamicResource FreeXStatusBarTextFontSize}"
                                       AutomationProperties.AutomationId="StatusMaxText"
                                       AutomationProperties.Name="{local:Loc Key=StatusBar_Maximum}"
                                       AutomationProperties.LiveSetting="Polite"
                                       MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- View shortcuts and zoom controls on the right -->
                <StackPanel x:Name="StatusInteractiveControls" Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="{DynamicResource FreeXStatusSurfaceBrush}"
                            Panel.ZIndex="1"
                            KeyboardNavigation.TabNavigation="Cycle"
                            KeyboardNavigation.ControlTabNavigation="Cycle"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                    <Button x:Name="UpdateReadyIndicator"
                            Visibility="Collapsed"
                            Click="UpdateReadyIndicator_Click"
                            Background="Transparent" BorderThickness="0" Padding="6,0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center" Cursor="Hand"
                            ToolTip="{local:Loc Key=MainWindow_ToolTip_UpdateReady}"
                            AutomationProperties.AutomationId="{x:Static presentation:FreeXAutomationIdCatalog.RibbonShellUpdateReadyIndicator}"
                            AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_UpdateReady}">
                        <TextBlock Text="{local:Loc Key=MainWindow_Content_UpdateReady}" Foreground="White" Opacity="0.75" FontSize="11"/>
                    </Button>
                    <TextBlock x:Name="StatusCapsLockText" Text="{local:Loc Key=StatusBar_CapsLock}" Foreground="White"
                               FontSize="{DynamicResource FreeXStatusBarTextFontSize}" VerticalAlignment="Center"
                               Margin="0,0,10,0" Visibility="Collapsed"
                               AutomationProperties.AutomationId="{x:Static presentation:FreeXAutomationIdCatalog.RibbonShellStatusCapsLockText}"
                               AutomationProperties.Name="{local:Loc Key=StatusBar_CapsLock}"/>
                    <TextBlock x:Name="StatusNumLockText" Text="{local:Loc Key=StatusBar_NumLock}" Foreground="White"
                               FontSize="{DynamicResource FreeXStatusBarTextFontSize}" VerticalAlignment="Center"
                               Margin="0,0,10,0" Visibility="Collapsed"
                               AutomationProperties.AutomationId="{x:Static presentation:FreeXAutomationIdCatalog.RibbonShellStatusNumLockText}"
                               AutomationProperties.Name="{local:Loc Key=StatusBar_NumLock}"/>
                    <StackPanel x:Name="StatusViewShortcutControls"
                                Orientation="Horizontal"
                                Height="24"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                        <ToggleButton x:Name="StatusNormalViewButton" Width="22" Height="22"
                                      Style="{StaticResource StatusBarViewToggleButtonStyle}"
                                      VerticalAlignment="Center" Click="NormalViewBtn_Click"
                                      ToolTip="{local:Loc Key=MainWindow_TooltipTitle_Normal}"
                                      AutomationProperties.Name="{local:Loc Key=MainWindow_Content_Normal}"
                                      AutomationProperties.HelpText="{local:Loc Key=MainWindow_TooltipDescription_ShowTheWorksheetInTheStandardEditingView}"
                                      AutomationProperties.AutomationId="StatusNormalViewButton"
                                      ribbonWpf:RibbonMetadata.CommandName="Normal">
                            <local:RibbonIcon Kind="Grid" IconSize="15"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="StatusPageLayoutViewButton" Width="22" Height="22"
                                      Margin="2,0,0,0"
                                      Style="{StaticResource StatusBarViewToggleButtonStyle}"
                                      VerticalAlignment="Center" Click="PageLayoutViewBtn_Click"
                                      ToolTip="{local:Loc Key=MainWindow_TooltipTitle_PageLayout}"
                                      AutomationProperties.Name="{local:Loc Key=MainWindow_Content_PageLayout}"
                                      AutomationProperties.HelpText="{local:Loc Key=MainWindow_TooltipDescription_ShowTheSheetWithPrintLayoutBoundaries}"
                                      AutomationProperties.AutomationId="StatusPageLayoutViewButton"
                                      ribbonWpf:RibbonMetadata.CommandName="Page Layout">
                            <local:RibbonIcon Kind="Page" IconSize="15"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="StatusPageBreakPreviewButton" Width="22" Height="22"
                                      Margin="2,0,0,0"
                                      Style="{StaticResource StatusBarViewToggleButtonStyle}"
                                      VerticalAlignment="Center" Click="PageBreakPreviewBtn_Click"
                                      ToolTip="{local:Loc Key=MainWindow_TooltipTitle_PageBreakPreview}"
                                      AutomationProperties.Name="{local:Loc Key=MainWindow_Content_PageBreakPreview}"
                                      AutomationProperties.HelpText="{local:Loc Key=MainWindow_TooltipDescription_ShowManualPageBreaksAndPrintAreaBoundariesWhileEditing}"
                                      AutomationProperties.AutomationId="StatusPageBreakPreviewButton"
                                      ribbonWpf:RibbonMetadata.CommandName="Page Break Preview">
                            <local:RibbonIcon Kind="PageBreak" IconSize="15"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                    </StackPanel>

                    <Grid x:Name="StatusZoomControls"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          MinWidth="38" Height="24"
                          Background="{DynamicResource FreeXStatusSurfaceBrush}"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="StatusZoomSliderControls"
                              Grid.Column="0"
                              MinWidth="168"
                              Height="24"
                              VerticalAlignment="Center"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="StatusZoomOutButton" Grid.Column="0" Width="22" Height="22"
                                    Style="{StaticResource StatusBarZoomButtonStyle}"
                                    Foreground="White" FontSize="18" FontWeight="SemiBold" Padding="0"
                                    VerticalAlignment="Center" Cursor="Hand" Click="ZoomOutBtn_Click"
                                    AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_ZoomOut}"
                                    AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationHelpText_DecreaseWorksheetZoom}"
                                    AutomationProperties.AutomationId="StatusZoomOutButton"
                                    ribbonWpf:RibbonTooltip.Title="{local:Loc Key=MainWindow_TooltipTitle_ZoomOut}"
                                    ribbonWpf:RibbonTooltip.KeyTip="SZ" ribbonWpf:RibbonMetadata.CommandName="Zoom Out">
                                <Grid Width="14" Height="14" SnapsToDevicePixels="True">
                                    <Rectangle Width="12" Height="2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Grid>
                            </Button>
                            <Slider x:Name="ZoomSlider" Grid.Column="2" Width="120" Height="22"
                                    VerticalAlignment="Center" Margin="0"
                                    AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_ZoomSlider}"
                                    AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationHelpText_AdjustWorksheetZoomFrom10To400}"
                                    ToolTip="{local:Loc Key=MainWindow_ToolTip_Zoom}"
                                    TickPlacement="BottomRight" IsSnapToTickEnabled="False"
                                    ValueChanged="ZoomSlider_ValueChanged"/>
                            <Button x:Name="StatusZoomInButton" Grid.Column="4" Width="22" Height="22"
                                    Style="{StaticResource StatusBarZoomButtonStyle}"
                                    Foreground="White" FontSize="18" FontWeight="SemiBold" Padding="0"
                                    VerticalAlignment="Center" Cursor="Hand" Click="ZoomInBtn_Click"
                                    AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_ZoomIn}"
                                    AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationHelpText_IncreaseWorksheetZoom}"
                                    AutomationProperties.AutomationId="StatusZoomInButton"
                                    ribbonWpf:RibbonTooltip.Title="{local:Loc Key=MainWindow_TooltipTitle_ZoomIn}"
                                    ribbonWpf:RibbonTooltip.KeyTip="SX" ribbonWpf:RibbonMetadata.CommandName="Zoom In">
                                <Grid Width="14" Height="14" SnapsToDevicePixels="True">
                                    <Rectangle Width="12" Height="2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <Rectangle Width="2" Height="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Grid>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="StatusZoomText" Grid.Column="1" Text="100%" Foreground="White" FontSize="{DynamicResource FreeXStatusBarTextFontSize}"
                                   VerticalAlignment="Center" Width="38" Focusable="True" Cursor="Hand"
                                   Margin="8,0,0,0"
                                   ToolTip="{local:Loc Key=MainWindow_ToolTip_Zoom}"
                                   AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_ZoomPercentage}"
                                   AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationHelpText_OpenTheZoomDialog}"
                                   AutomationProperties.AutomationId="StatusZoomText"
                                   MouseLeftButtonUp="StatusZoomText_OpenZoomDialog"
                                   PreviewKeyDown="StatusZoomText_PreviewKeyDown"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- START SCREEN - full-window overlay shown at launch / via Backstage Home -->
        <!-- Transparent input blocker shown while a workbook open/save runs.  Excel keeps the sheet
             visible during these operations rather than greying it out, so this layer only intercepts
             input over the editing surface (rows 1-5); the title bar and the footer (where the actual
             progress bar lives) stay live.  The visible progress is the status-bar StatusSaveProgressPanel. -->
        <Border x:Name="OpenProgressOverlay"
                Grid.Row="1" Grid.RowSpan="5"
                Panel.ZIndex="260"
                Background="Transparent"
                Focusable="False"
                Visibility="Collapsed"
                AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_OpeningWorkbook}"
                AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationHelpText_ShowsWorkbookOpenProgressAndBlocksWorkbookInteractionUntilLoadingFinishe_45BE9EDF}"/>

        <!-- The hand-rolled StartScreenSidebar rail was removed in the unification program (P1): the rail
             is now the shared Free.Shared.Ribbon.Wpf.BackstageFrame, built in MainWindow.BackstageFrame.cs
             and hosted in StartScreenFrameHost below. The three content panes (SsHomeView/SsInfoView/
             SsPrintView) are kept verbatim, parked collapsed in StartScreenPaneHolder; each pane entry's
             ContentFactory reparents the live pane into the frame's content host on selection. -->
        <Grid x:Name="StartScreenOverlay"
              Grid.Row="1" Grid.RowSpan="5"
              Panel.ZIndex="200"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle"
              Visibility="Collapsed">

            <!-- Hidden holder: keeps the pane elements alive and named so the BackstageFrame factories can
                 grab + reparent them. Collapsed and zero-size so it never paints behind the frame. -->
            <Grid x:Name="StartScreenPaneHolder" Visibility="Collapsed"
                  Width="0" Height="0" IsHitTestVisible="False">
                <Grid x:Name="SsHomeView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Greeting -->
                    <RowDefinition Height="Auto"/>  <!-- New section -->
                    <RowDefinition Height="*"/>     <!-- Recent files -->
                </Grid.RowDefinitions>

                <!-- Greeting -->
                <TextBlock x:Name="SsGreeting" Grid.Row="0"
                           FontSize="28" FontWeight="Light" Foreground="#1F1F1F"
                           Margin="40,36,40,0"/>

                <!-- New section -->
                <Border Grid.Row="1" Padding="40,18,40,6">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="{local:Loc Key=Common_New}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                            <Button DockPanel.Dock="Right" Content="{local:Loc Key=MainWindow_Content_MoreTemplatesExcluded}"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    FontSize="12" Foreground="#0F6D8C"
                                    VerticalAlignment="Center" Cursor="Hand"
                                    AutomationProperties.AutomationId="MoreTemplatesExcludedButton"
                                    AutomationProperties.Name="{local:Loc Key=MainWindow_AutomationName_MoreTemplatesUnavailable}"
                                    AutomationProperties.HelpText="{local:Loc Key=MainWindow_AutomationHelpText_OnlineTemplateDiscoveryDependsOnAnExternalMicrosoftTemplateServiceAndIsE_D9AF02A3}"
                                    Click="SsMoreTemplatesBtn_Click"
                                    ribbonWpf:RibbonTooltip.Title="{local:Loc Key=MainWindow_TooltipTitle_MoreTemplatesExcluded}"
                                    ribbonWpf:RibbonTooltip.KeyTip="MT"
                                    ribbonWpf:RibbonTooltip.Description="{local:Loc Key=MainWindow_TooltipDescription_OnlineTemplateDiscoveryDependsOnAnExternalMicrosoftTemplateServiceAndIsE_FB222BC1}" ribbonWpf:RibbonMetadata.CommandName="More Templates Excluded"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal">
                            <!-- Blank workbook card -->
                            <Button Click="SsBlankWorkbook_Click" Cursor="Hand" Margin="0,0,16,0"
                                    ribbonWpf:RibbonTooltip.Title="{local:Loc Key=MainWindow_TooltipTitle_BlankWorkbook}"
                                    ribbonWpf:RibbonTooltip.KeyTip="B1" ribbonWpf:RibbonMetadata.CommandName="Blank Workbook">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="cardBg" Background="Transparent" Padding="4">
                                            <StackPanel Width="108">
                                                <!-- Mini spreadsheet thumbnail -->
                                                <Border Width="108" Height="80"
                                                        BorderBrush="#C8C8C8" BorderThickness="1"
                                                        Background="White" ClipToBounds="True">
                                                    <Canvas Width="108" Height="80">
                                                        <!-- Row-header strip -->
                                                        <Rectangle Canvas.Left="0" Canvas.Top="0"
                                                                   Width="18" Height="80" Fill="#F0F0F0"/>
                                                        <!-- Column-header strip -->
                                                        <Rectangle Canvas.Left="0" Canvas.Top="0"
                                                                   Width="108" Height="14" Fill="#F0F0F0"/>
                                                        <!-- Horizontal grid lines -->
                                                        <Line X1="0" Y1="27" X2="108" Y2="27"
                                                              Stroke="#DCDCDC" StrokeThickness="0.5"/>
                                                        <Line X1="0" Y1="40" X2="108" Y2="40"
                                                              Stroke="#DCDCDC" StrokeThickness="0.5"/>
                                                        <Line X1="0" Y1="53" X2="108" Y2="53"
                                                              Stroke="#DCDCDC" StrokeThickness="0.5"/>
                                                        <Line X1="0" Y1="66" X2="108" Y2="66"
                                                              Stroke="#DCDCDC" StrokeThickness="0.5"/>
                                                        <!-- Vertical grid lines -->
                                                        <Line X1="42" Y1="14" X2="42" Y2="80"
                                                              Stroke="#DCDCDC" StrokeThickness="0.5"/>
                                                        <Line X1="66" Y1="14" X2="66" Y2="80"
                                                              Stroke="#DCDCDC" StrokeThickness="0.5"/>
                                                        <Line X1="90" Y1="14" X2="90" Y2="80"
                                                              Stroke="#DCDCDC" StrokeThickness="0.5"/>
                                                        <!-- Selected cell A1 -->
                                                        <Rectangle Canvas.Left="18" Canvas.Top="14"
                                                                   Width="24" Height="13"
                                                                   Fill="#E6F6FA"/>
                                                        <Rectangle Canvas.Left="18" Canvas.Top="14"
                                                                   Width="24" Height="13"
                                                                   Stroke="#0F6D8C" StrokeThickness="1.5"
                                                                   Fill="Transparent"/>
                                                    </Canvas>
                                                </Border>
                                                <TextBlock Text="{local:Loc Key=MainWindow_Text_BlankWorkbook}"
                                                           FontSize="12" Margin="0,6,0,2"
                                                           TextAlignment="Center"
                                                           Foreground="#1F1F1F"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cardBg" Property="Background"
                                                        Value="#EEF8FA"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recent files -->
                <Grid Grid.Row="2" Margin="40,0,40,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Tabs + search -->
                        <RowDefinition Height="Auto"/> <!-- Column headers -->
                        <RowDefinition Height="*"/>    <!-- File list -->
                    </Grid.RowDefinitions>

                    <!-- Tabs row + search box -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,0">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button x:Name="SsRecentTabButton"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Cursor="Hand" Click="SsRecentTab_Click"
                                    AutomationProperties.Name="{Binding ElementName=SsRecentTabText, Path=Text}">
                                <Border x:Name="SsRecentTab" Padding="0,8,22,8"
                                        BorderThickness="0,0,0,2" BorderBrush="#0F6D8C">
                                <TextBlock x:Name="SsRecentTabText" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#0F6D8C"/>
                                </Border>
                            </Button>
                            <Button x:Name="SsPinnedTabButton"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Cursor="Hand" Click="SsPinnedTab_Click"
                                    AutomationProperties.Name="{Binding ElementName=SsPinnedTabText, Path=Text}">
                                <Border x:Name="SsPinnedTab" Padding="0,8,22,8"
                                        BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                <TextBlock x:Name="SsPinnedTabText" FontSize="13"
                                           Foreground="#888"/>
                                </Border>
                            </Button>
                        </StackPanel>
                        <Border DockPanel.Dock="Right"
                                Background="#F5F5F5" BorderBrush="#D8D8D8" BorderThickness="1"
                                CornerRadius="2" Padding="8,4" VerticalAlignment="Center">
                            <TextBox x:Name="SsSearchBox" Width="180" FontSize="12"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SsSearchBox_TextChanged"/>
                        </Border>
                    </DockPanel>

                    <!-- Column headers -->
                    <Border Grid.Row="1" BorderThickness="0,1,0,1" BorderBrush="#E4E4E4"
                            Padding="0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SsRecentNameColumnHeader" Grid.Column="0" FontSize="11" Foreground="#888"/>
                            <TextBlock x:Name="SsRecentDateModifiedColumnHeader" Grid.Column="1" FontSize="11" Foreground="#888"/>
                        </Grid>
                    </Border>

                    <!-- File list (Recent) -->
                    <ScrollViewer x:Name="SsRecentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SsRecentList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Stretch"
                                            BorderThickness="0" Padding="0,7"
                                            Click="SsRecentItem_Click"
                                            Loaded="SsRecentFileItem_Loaded"
                                            Cursor="Hand"
                                            AutomationProperties.Name="{Binding OpenAutomationName}"
                                            AutomationProperties.HelpText="{Binding OpenAutomationHelpText}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="rowBg" Background="Transparent"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="rowBg" Property="Background"
                                                                Value="#F3F6F9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Border Width="26" Height="30" Background="#0F6D8C"
                                                        CornerRadius="2" Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="X" Foreground="White"
                                                               FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontSize="13" Foreground="#1F1F1F"/>
                                                    <TextBlock Text="{Binding Directory}"
                                                               FontSize="11" Foreground="#888"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LastOpenedText}"
                                                       FontSize="12" Foreground="#666"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource BackstageRecentPinCommandButton}"
                                                    Click="SsPinItem_Click"
                                                    Loaded="SsRecentPinCommandButton_Loaded"
                                                    AutomationProperties.Name="{Binding PinAutomationName}"
                                                    AutomationProperties.HelpText="{Binding PinAutomationHelpText}"
                                                    >
                                                <local:RibbonIcon CommandName="Pin to list" Kind="Pin" Style="{StaticResource BackstageRecentPinCommandIcon}"/>
                                            </Button>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- File list (Pinned) -->
                    <ScrollViewer x:Name="SsPinnedScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="SsPinnedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Stretch"
                                            BorderThickness="0" Padding="0,7"
                                            Click="SsRecentItem_Click"
                                            Loaded="SsPinnedFileItem_Loaded"
                                            Cursor="Hand"
                                            AutomationProperties.Name="{Binding OpenAutomationName}"
                                            AutomationProperties.HelpText="{Binding OpenAutomationHelpText}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="rowBg" Background="Transparent"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="rowBg" Property="Background"
                                                                Value="#F3F6F9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Border Width="26" Height="30" Background="#0F6D8C"
                                                        CornerRadius="2" Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="X" Foreground="White"
                                                               FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontSize="13" Foreground="#1F1F1F"/>
                                                    <TextBlock Text="{Binding Directory}"
                                                               FontSize="11" Foreground="#888"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LastOpenedText}"
                                                       FontSize="12" Foreground="#666"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource BackstageRecentPinCommandButton}"
                                                    Click="SsUnpinItem_Click"
                                                    Loaded="SsPinnedUnpinCommandButton_Loaded"
                                                    AutomationProperties.Name="{Binding PinAutomationName}"
                                                    AutomationProperties.HelpText="{Binding PinAutomationHelpText}"
                                                    >
                                                <local:RibbonIcon CommandName="Unpin from list" Kind="Pin" Style="{StaticResource BackstageRecentPinCommandIcon}"/>
                                            </Button>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                </Grid><!-- end SsHomeView -->

                <!-- ══ INFO VIEW ════════════════════════════════════════════ -->
                <Grid x:Name="SsInfoView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{local:Loc Key=MainWindow_Text_Info}"
                               FontSize="28" FontWeight="Light" Foreground="#1F1F1F"
                               Margin="40,36,40,0"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="40,24,40,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Workbook actions (left) -->
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="{local:Loc Key=MainWindow_Text_WorkbookActions}"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <Button x:Name="InfoProtectWorkbookButton"
                                        Content="{local:Loc Key=MainWindow_Content_ProtectWorkbook}"
                                        Width="220" Height="30"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,6"/>
                                <TextBlock Text="{local:Loc Key=MainWindow_Text_ControlWhatTypesOfChangesOthersCanMake}"
                                           FontSize="12" Foreground="#555" TextWrapping="Wrap"
                                           Margin="0,0,0,20"/>

                                <Button x:Name="InfoCheckAccessibilityButton"
                                        Content="{local:Loc Key=MainWindow_Text_CheckAccessibility}"
                                        Width="220" Height="30"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,6"/>
                                <TextBlock Text="{local:Loc Key=MainWindow_Text_FindMergedCellsAndObjectsMissingAltText}"
                                           FontSize="12" Foreground="#555" TextWrapping="Wrap"
                                           Margin="0,0,0,20"/>

                                <Button x:Name="InfoWorkbookStatisticsButton"
                                        Content="{local:Loc Key=MainWindow_Content_WorkbookStatistics}"
                                        Width="220" Height="30"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,6"/>

                                <Button x:Name="InfoErrorCheckingButton"
                                        Content="{local:Loc Key=MainWindow_Content_ErrorChecking}"
                                        Width="220" Height="30"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,6"/>
                                <TextBlock Text="{local:Loc Key=MainWindow_Text_ReviewLocalFileStatusAndUnsupportedWorkbookFeatureWarnings}"
                                           FontSize="12" Foreground="#555" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Properties (right) -->
                            <Border Grid.Column="1"
                                    BorderBrush="#E0E0E0" BorderThickness="1,0,0,0"
                                    Padding="24,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_Properties}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#555"
                                               Margin="0,0,0,14"/>

                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_WorkbookName}" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="InfoWorkbookName" FontSize="13" Foreground="#1F1F1F" Margin="0,0,0,12"/>

                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_FilePath}" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="InfoFilePath" FontSize="12" Foreground="#555"
                                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_Sheets}" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="InfoSheetCount" FontSize="13" Foreground="#1F1F1F" Margin="0,0,0,12"/>

                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_Format}" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="InfoFormat" FontSize="13" Foreground="#1F1F1F" Margin="0,0,0,20"/>

                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_FileSize}" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="InfoFileSize" FontSize="13" Foreground="#1F1F1F" Margin="0,0,0,12"/>

                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_LastModified}" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="InfoLastModified" FontSize="13" Foreground="#1F1F1F" Margin="0,0,0,12"/>

                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_Share}" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="InfoShareStatus" FontSize="13" Foreground="#1F1F1F"
                                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_Export}" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="InfoExportStatus" FontSize="13" Foreground="#1F1F1F"
                                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_WorkbookProtection}" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="InfoWorkbookProtectionSummary" FontSize="13" Foreground="#1F1F1F"
                                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_ActiveSheetProtection}" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="InfoActiveSheetProtectionSummary" FontSize="13" Foreground="#1F1F1F"
                                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_WorkbookStatistics}" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="InfoStatisticsSummary" FontSize="12" Foreground="#555"
                                               TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>

                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_Accessibility}" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="InfoAccessibilitySummary" FontSize="13" Foreground="#1F1F1F" Margin="0,0,0,20"/>

                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_FormulaErrors}" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="InfoFormulaErrorSummary" FontSize="13" Foreground="#1F1F1F" Margin="0,0,0,20"/>

                                    <Rectangle Height="1" Fill="#E0E0E0" Margin="0,0,0,20"/>

                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_AboutFreeX}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#555"
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_FreeXDescription}"
                                               FontSize="12" Foreground="#555"
                                               TextWrapping="Wrap" LineHeight="20"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_FreeXTrademarkDisclaimer}"
                                               FontSize="11" Foreground="#666"
                                               TextWrapping="Wrap" LineHeight="18"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="{local:Loc Key=MainWindow_Text_Version05TesterRelease}"
                                               FontSize="11" Foreground="#888"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid><!-- end SsInfoView -->

                <!-- PRINT VIEW -->
                <Grid x:Name="SsPrintView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{local:Loc Key=MainWindow_Text_Print}"
                               FontSize="28" FontWeight="Light" Foreground="#1F1F1F"
                               Margin="40,36,40,0"/>

                    <Grid Grid.Row="1" Margin="40,24,40,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0"
                                      Margin="0,0,24,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Button x:Name="SsBackstagePrintNowButton"
                                    Content="{local:Loc Key=PrintPreview_PrintButton}"
                                    Width="220" MinHeight="34"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,16"
                                    Click="BackstagePrintNowButton_Click"
                                    AutomationProperties.AutomationId="BackstagePrintNowButton"
                                    AutomationProperties.Name="{local:Loc Key=PrintPreview_PrintAutomationName}"
                                    AutomationProperties.HelpText="{local:Loc Key=PrintPreview_PrintHelpText}"
                                    ribbonWpf:RibbonTooltip.Title="{local:Loc Key=MainWindow_TooltipTitle_Print}"
                                    ribbonWpf:RibbonTooltip.KeyTip="V"
                                    ribbonWpf:RibbonTooltip.Description="{local:Loc Key=PrintPreview_PrintToolTip}"
                                    ribbonWpf:RibbonMetadata.CommandName="Print"/>
                                <TextBlock Text="{local:Loc Key=MainWindow_Text_Print}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#555"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="SsPrintSettingsSummary"
                                           FontSize="13" Foreground="#1F1F1F"
                                           TextWrapping="Wrap" LineHeight="20"
                                           Margin="0,0,0,12"
                                           AutomationProperties.Name="{local:Loc Key=PrintPreview_SettingsSummaryAutomationName}"
                                           AutomationProperties.HelpText="{local:Loc Key=PrintPreview_SettingsSummaryHelpText}"/>
                                <ContentControl x:Name="SsPrintOptionsHost"
                                                AutomationProperties.AutomationId="BackstagePrintOptionsHost"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Column="1"
                                BorderBrush="#E0E0E0" BorderThickness="1,0,0,0"
                                Padding="24,0,0,0">
                            <DocumentViewer x:Name="SsPrintPreviewViewer"
                                            AutomationProperties.AutomationId="BackstagePrintPreviewViewer"
                                            AutomationProperties.Name="{local:Loc Key=PageSetup_PrintPreviewAutomationName}"/>
                        </Border>
                    </Grid>
                </Grid><!-- end SsPrintView -->

            </Grid><!-- end StartScreenPaneHolder -->

            <!-- The shared backstage frame (rail + content host) fills the overlay; the panes above flow
                 into its content host via the per-entry ContentFactory in MainWindow.BackstageFrame.cs. -->
            <ContentControl x:Name="StartScreenFrameHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>

        <Canvas x:Name="KeyTipOverlay"
                Grid.RowSpan="6"
                Panel.ZIndex="1000"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>

    </Grid>
</Window>
