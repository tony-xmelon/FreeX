<Window x:Class="FreeX.App.Host.PivotFieldFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FreeX.App.Host"
        Title="{local:Loc Key=PivotFieldFilter_Filter}"
        Width="380"
        Height="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Bottom"
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ClearFieldFiltersButton"
                    Grid.Column="0"
                    Content="{local:Loc Key=PivotFieldFilter_ClearFiltersFromThisField}"
                    MinWidth="160"
                    HorizontalAlignment="Left"
                    Click="ClearFieldFiltersButton_Click"
                    AutomationProperties.Name="{local:Loc Key=PivotFieldFilter_ClearFiltersFromThisFieldAutomationName}"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{local:Loc Key=Common_Ok}"
                        Width="74"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="OkButton_Click"/>
                <Button Content="{local:Loc Key=Common_Cancel}"
                        Width="74"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="FilterTabs">
            <TabItem x:Name="SelectItemsTab"
                     Header="{local:Loc Key=PivotFieldFilter_SelectItems}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{local:Loc Key=PivotFieldFilter_ChooseItemsToShow}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="ItemFilterSummaryText"
                               Grid.Row="1"
                               Text="{local:Loc Key=PivotFieldFilter_NoItemFilter}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <Label Grid.Row="2"
                           Content="{local:Loc Key=PivotFieldFilter_Search}"
                           Target="{Binding ElementName=FilterSearchBox}"
                           Padding="0"
                           Margin="0,0,0,4"/>
                    <TextBox x:Name="FilterSearchBox"
                             Grid.Row="3"
                             Margin="0,0,0,8"
                             TextChanged="FilterSearchBox_TextChanged"
                             AutomationProperties.Name="{local:Loc Key=PivotFieldFilter_SearchPivotTableFilterItems}"/>

                    <CheckBox x:Name="SelectAllCheckBox"
                              Grid.Row="4"
                              Content="{local:Loc Key=PivotFieldFilter_SelectAll}"
                              IsThreeState="True"
                              Margin="2,0,0,6"
                              Click="SelectAllCheckBox_Click"/>
                    <Button x:Name="ClearItemFilterButton"
                            Grid.Row="5"
                            Content="{local:Loc Key=PivotFieldFilter_ClearItemFilter}"
                            Width="120"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            Click="ClearItemFilterButton_Click"
                            AutomationProperties.Name="{local:Loc Key=PivotFieldFilter_ClearItemFilterAutomationName}"/>

                    <ListBox x:Name="FilterItemsList"
                             Grid.Row="6"
                             BorderBrush="#BDBDBD"
                             AutomationProperties.Name="{local:Loc Key=PivotFieldFilter_PivotTableFilterItems}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Caption}"
                                          IsChecked="{Binding IsChecked}"
                                          Click="FilterItemCheckBox_Click"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem x:Name="LabelFiltersTab"
                     Header="{local:Loc Key=PivotFieldFilter_LabelFilters}">
                <StackPanel Margin="10">
                    <TextBlock x:Name="LabelFilterSummaryText"
                               Text="{local:Loc Key=PivotFieldFilter_NoLabelFilter}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{local:Loc Key=PivotFieldFilter_ManageLabelFiltersDescription}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LabelFilterButton"
                                Content="{local:Loc Key=PivotFieldFilter_LabelFilter}"
                                Width="140"
                                HorizontalAlignment="Left"
                                Click="LabelFilterButton_Click"
                                AutomationProperties.Name="{local:Loc Key=PivotFieldFilter_OpenPivotTableLabelFilterDialog}"/>
                        <Button x:Name="RemoveLabelFilterButton"
                                Content="{local:Loc Key=PivotFieldFilter_RemoveLabelFilter}"
                                Width="140"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Left"
                                Click="RemoveLabelFilterButton_Click"
                                AutomationProperties.Name="{local:Loc Key=PivotFieldFilter_RemoveLabelFilterAutomationName}"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="ValueFiltersTab"
                     Header="{local:Loc Key=PivotFieldFilter_ValueFilters}">
                <StackPanel Margin="10">
                    <TextBlock x:Name="ValueFilterSummaryText"
                               Text="{local:Loc Key=PivotFieldFilter_NoValueFilter}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{local:Loc Key=PivotFieldFilter_ManageValueFiltersDescription}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="ValueFilterUnavailableText"
                               Text="{local:Loc Key=PivotFieldFilter_AddAtLeastOnePivotTableValueFieldToUseValueFilters}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ValueFilterButton"
                                Content="{local:Loc Key=PivotFieldFilter_ValueFilter}"
                                Width="140"
                                HorizontalAlignment="Left"
                                Click="ValueFilterButton_Click"
                                AutomationProperties.Name="{local:Loc Key=PivotFieldFilter_OpenPivotTableValueFilterDialog}"/>
                        <Button x:Name="RemoveValueFilterButton"
                                Content="{local:Loc Key=PivotFieldFilter_RemoveValueFilter}"
                                Width="140"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Left"
                                Click="RemoveValueFilterButton_Click"
                                AutomationProperties.Name="{local:Loc Key=PivotFieldFilter_RemoveValueFilterAutomationName}"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
