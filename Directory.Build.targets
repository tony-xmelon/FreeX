<Project>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)tests\SharedTestInfrastructure\*.cs"
             Exclude="$(MSBuildThisFileDirectory)tests\SharedTestInfrastructure\LocalizationWrapperContractTestSupport.cs;
                      $(MSBuildThisFileDirectory)tests\SharedTestInfrastructure\RecordingUserMessageService.cs;
                      $(MSBuildThisFileDirectory)tests\SharedTestInfrastructure\XunitDisableTestParallelization.cs"
             Link="%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)tests\SharedTestInfrastructure\LocalizationWrapperContractTestSupport.cs"
             Link="%(Filename)%(Extension)"
             Condition="'$(MSBuildProjectName)' == 'FreeX.App.Localization.Tests' Or
                        '$(MSBuildProjectName)' == 'FreeW.App.Localization.Tests' Or
                        '$(MSBuildProjectName)' == 'FreeP.App.Localization.Tests'" />
    <Compile Include="$(MSBuildThisFileDirectory)tests\SharedTestInfrastructure\RecordingUserMessageService.cs"
             Link="%(Filename)%(Extension)"
             Condition="'$(MSBuildProjectName)' == 'FreeW.App.Host.Tests' Or
                        '$(MSBuildProjectName)' == 'FreeP.App.Host.Tests'" />
    <Compile Include="$(MSBuildThisFileDirectory)tests\SharedTestInfrastructure\XunitDisableTestParallelization.cs"
             Link="%(Filename)%(Extension)"
             Condition="'$(MSBuildProjectName)' == 'FreeP.App.Host.Tests' Or
                        '$(MSBuildProjectName)' == 'FreeP.App.Rendering.Avalonia.Tests' Or
                        '$(MSBuildProjectName)' == 'Free.Shared.Ribbon.Tests'" />
  </ItemGroup>

  <Target Name="FilterFreeSharedLocalizationSatelliteResources"
          BeforeTargets="_CopyFilesMarkedCopyLocal;CopyFilesToOutputDirectory"
          Condition="'$(FreeSharedLocalizationProduct)' != ''">
    <ItemGroup>
      <_FreeSharedLocalizationSatellites Include="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'Free.Shared.Localization.resources'" />
      <_FreeSharedLocalizationSupported Include="@(_FreeSharedLocalizationSatellites)"
        Condition="'$(FreeSharedLocalizationFilterAllSatellites)' != 'true' And
          '$([System.Text.RegularExpressions.Regex]::IsMatch(&quot;%(_FreeSharedLocalizationSatellites.DestinationSubDirectory)&quot;, &quot;^($(FreeSharedLocalizationSupportedCulturePattern))[\\/]$&quot;))' == 'True'" />
      <ReferenceCopyLocalPaths Remove="@(_FreeSharedLocalizationSatellites)" />
      <ReferenceCopyLocalPaths Include="@(_FreeSharedLocalizationSupported)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveFreeSharedLocalizationSatellitesForEnglishOnly"
          AfterTargets="_CopyFilesMarkedCopyLocal"
          Condition="'$(FreeSharedLocalizationFilterAllSatellites)' == 'true'">
    <ItemGroup>
      <_FreeSharedLocalizationEnglishOnlySatellite Include="$(TargetDir)**\Free.Shared.Localization.resources.dll" />
    </ItemGroup>
    <Delete Files="@(_FreeSharedLocalizationEnglishOnlySatellite)" />
  </Target>
</Project>
