<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Neutral draw-op model lives in Free.Shared.Pdf; this companion adds the SkiaSharp emitter
         (HarfBuzz shaping + automatic font embedding/subsetting) so non-WinAnsi text exports
         without bundling a font. Mirrors the Free.Shared.Shell / Free.Shared.Shell.Wpf split. -->
    <ProjectReference Include="..\Free.Shared.Pdf\Free.Shared.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Free.Shared.Pdf.Tests" />
    <InternalsVisibleTo Include="Free.Shared.Pdf.Skia.Tests" />
  </ItemGroup>

</Project>
