<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF/PDFsharp companion to the neutral Free.Shared.Pdf tier: rasterized-page + overlay
         emission used by both FreeX and FreeW host (Windows) PDF export. Mirrors the
         Free.Shared.Shell / Free.Shared.Shell.Wpf split. -->
    <ProjectReference Include="..\Free.Shared.Pdf\Free.Shared.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-WPF" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Free.Shared.Pdf.Wpf.Tests" />
  </ItemGroup>

</Project>
