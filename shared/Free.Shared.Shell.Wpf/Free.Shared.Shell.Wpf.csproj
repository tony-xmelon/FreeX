<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Portable shell tier: IShellStrings/ShellStrings the WPF helpers consume,
         plus the neutral planners these realizers sit alongside. -->
    <ProjectReference Include="..\Free.Shared.Shell\Free.Shared.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF-coupled shell helpers extracted from FreeX.App.Host. Kept internal-visible
         to their existing FreeX consumers until promoted to the public shared API. -->
    <InternalsVisibleTo Include="FreeX.App.Host" />
    <InternalsVisibleTo Include="FreeX.App.Host.Tests" />
    <InternalsVisibleTo Include="FreeX.App.Host.Logic.Tests" />
  </ItemGroup>

</Project>
