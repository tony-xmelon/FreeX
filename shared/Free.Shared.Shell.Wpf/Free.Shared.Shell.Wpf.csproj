<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Portable shell tier: IShellStrings/ShellStrings the WPF helpers consume,
         plus the neutral planners these realizers sit alongside. -->
    <ProjectReference Include="..\Free.Shared.Shell\Free.Shared.Shell.csproj" />
    <ProjectReference Include="..\Free.Shared.AppServices\Free.Shared.AppServices.csproj" />
    <ProjectReference Include="..\Free.Shared.IO\Free.Shared.IO.csproj" />
    <ProjectReference Include="..\Free.Shared.Localization\Free.Shared.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Host tests exercise internal dialog sizing and startup diagnostics contracts. -->
    <InternalsVisibleTo Include="FreeX.App.Host.Tests" />
    <InternalsVisibleTo Include="FreeW.App.Host.Tests" />
  </ItemGroup>

</Project>
