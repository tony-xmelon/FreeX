<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Free.Shared.Shell;assembly=Free.Shared.Shell"
                    xmlns:local="clr-namespace:Free.Shared.Shell.Wpf">

    <!-- ════════════════════════════════════════════════════════════════════
         Shared dialog control theme.

         App-neutral modern flat styles for the controls used in code-built
         dialogs (Button / TextBox / ComboBox / CheckBox / GroupBox / Label),
         so a host's dialogs read as one clean Word-style surface instead of
         the dated default WPF (Aero) theme. Scoped via DialogWindow (merged
         into the window's own resources) so it never touches the ribbon.

         Keys: DialogPrimaryButton (accent OK/primary button). Everything else
         is default-targeted (applies to every plain control in the dialog).
         ════════════════════════════════════════════════════════════════════ -->

    <!-- NEUTRAL dialog brushes — tokenized (WS-G round 8).
         DialogText aliases ThemeNeutralTextBrush (#1F1F1F), identical across FreeX/FreeW/FreeP.
         All other dialog brushes are accent-derived or structural — left inline (see classification). -->
    <DynamicResource x:Key="DialogText" ResourceKey="ThemeNeutralTextBrush"/>
    <!-- Structural border shades: #C8C8C8 ≠ BorderStrong (#C8CCD0); #B7BCC2 has no exact role match. -->
    <SolidColorBrush x:Key="DialogBorder"      Color="{x:Static shell:CompactDialogVisualTokens.BorderHex}"/>
    <SolidColorBrush x:Key="DialogFieldBorder" Color="{x:Static shell:CompactDialogVisualTokens.FieldBorderHex}"/>
    <!-- ACCENT-DERIVED — tokenized (WS-G round 9).  ThemeAccent*Brush keys are registered by
         WpfThemeApplier.BuildResources with per-app values: FreeX/FreeW teal, FreeP brick.
         The Dialog* aliases remain available for callers that bind dynamically by key. Styles in this
         dictionary bind directly to the Theme* keys so dialogs opened before an app theme is attached
         do not receive WPF's ResourceReferenceExpression alias object as a Brush value. -->
    <DynamicResource x:Key="DialogAccent"     ResourceKey="ThemeAccentBrush"/>
    <DynamicResource x:Key="DialogAccentDark" ResourceKey="ThemeAccentDarkBrush"/>
    <DynamicResource x:Key="DialogHover"      ResourceKey="ThemeAccentSoftBrush"/>
    <DynamicResource x:Key="DialogPressed"    ResourceKey="ThemeAccentPressedBrush"/>

    <!-- Standard dialog button: white resting fill + subtle border; hover/press wash with accent border. -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="MinHeight" Value="{x:Static shell:CompactDialogVisualTokens.ButtonHeight}"/>
        <Setter Property="Padding" Value="{x:Static local:WpfCompactDialogMetrics.ButtonPadding}"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{x:Static shell:CompactDialogVisualTokens.FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeNeutralTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeNeutralWhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogBorder}"/>
        <Setter Property="BorderThickness" Value="{x:Static local:WpfCompactDialogMetrics.UniformBorderThickness}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{x:Static local:WpfCompactDialogMetrics.ButtonCornerRadius}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeAccentPressedBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- #9AA0A6 and #E0E0E0: structural disabled shades with no exact theme role. -->
                            <Setter Property="Foreground" Value="{x:Static shell:CompactDialogVisualTokens.DisabledForegroundHex}"/>
                            <!-- SheetSurface (#F3F3F3): neutral role, identical across all 3 brand themes. -->
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeNeutralSheetSurfaceBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{x:Static shell:CompactDialogVisualTokens.DisabledBorderHex}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent primary button (OK / Insert / Apply): teal fill, white text. -->
    <Style x:Key="DialogPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeNeutralWhiteBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{x:Static local:WpfCompactDialogMetrics.ButtonCornerRadius}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{x:Static shell:CompactDialogVisualTokens.PrimaryPressedHex}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{x:Static shell:CompactDialogVisualTokens.PrimaryPressedHex}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{x:Static shell:CompactDialogVisualTokens.PrimaryDisabledHex}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{x:Static shell:CompactDialogVisualTokens.PrimaryDisabledHex}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input: white field, calm border, accent focus ring (property-only — no template rewrite). -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{x:Static shell:CompactDialogVisualTokens.FontSize}"/>
        <Setter Property="MinHeight" Value="{x:Static shell:CompactDialogVisualTokens.ControlHeight}"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeNeutralTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeNeutralWhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogFieldBorder}"/>
        <Setter Property="BorderThickness" Value="{x:Static local:WpfCompactDialogMetrics.UniformBorderThickness}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox: align sizing/typography with the text fields (property-only, keeps the default template). -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{x:Static shell:CompactDialogVisualTokens.FontSize}"/>
        <Setter Property="MinHeight" Value="{x:Static shell:CompactDialogVisualTokens.ControlHeight}"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeNeutralTextBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- CheckBox / RadioButton: consistent typography + comfortable hit target. -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{x:Static shell:CompactDialogVisualTokens.FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeNeutralTextBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,0,0,0"/>
    </Style>
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{x:Static shell:CompactDialogVisualTokens.FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeNeutralTextBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,0,0,0"/>
    </Style>

    <!-- Labels / static text default to the dialog typography. -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{x:Static shell:CompactDialogVisualTokens.FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeNeutralTextBrush}"/>
    </Style>
    <Style TargetType="{x:Type Label}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{x:Static shell:CompactDialogVisualTokens.FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeNeutralTextBrush}"/>
        <Setter Property="Padding" Value="0,0,0,0"/>
    </Style>

    <!-- GroupBox: clean accent-tinted header, light rule. -->
    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{x:Static shell:CompactDialogVisualTokens.FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogBorder}"/>
        <Setter Property="BorderThickness" Value="{x:Static local:WpfCompactDialogMetrics.UniformBorderThickness}"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

</ResourceDictionary>
