<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:wpf="clr-namespace:Free.Shared.Ribbon.Wpf">

    <!-- ════════════════════════════════════════════════════════════════════
         Shared window-chrome resources.

         App-neutral port of the FreeX window chrome (title bar caption buttons,
         flat command buttons, clean status-bar buttons). Both FreeW and FreeX
         could merge this dictionary; it defines its own brushes (prefixed
         "Chrome*") so it has no dependency on any app-specific resource keys.

         Keys exposed:
           ChromeFlatButtonStyle          — flat command button (no border/fill until hover)
           ChromeCaptionButtonStyle       — min / max-restore caption button (light-on-dark)
           ChromeCaptionCloseButtonStyle  — close caption button (red hover)
           ChromeStatusButtonStyle        — clean status-bar button (light-on-dark, rounded hover)
           ChromeStatusToggleButtonStyle  — clean status-bar toggle button
         ════════════════════════════════════════════════════════════════════ -->

    <!-- ── Brushes (self-contained; tuned to the FreeX #17324D navy title/status bar) ──── -->
    <SolidColorBrush x:Key="ChromeWhiteBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ChromeTextBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="ChromeMutedTextBrush" Color="#5F6368"/>
    <!-- Flat (light-background) command-button hover/press fills -->
    <SolidColorBrush x:Key="ChromeButtonHoverBrush" Color="#D6EEF4"/>
    <SolidColorBrush x:Key="ChromeButtonPressedBrush" Color="#BFE2EC"/>
    <SolidColorBrush x:Key="ChromeButtonBorderBrush" Color="#8FC3D2"/>
    <SolidColorBrush x:Key="ChromeAccentBrush" Color="#0F6D8C"/>
    <!-- Title-bar / status-bar (dark-background) hover/press fills — FreeX #17324D navy family -->
    <SolidColorBrush x:Key="ChromeCaptionHoverBrush" Color="#264B6B"/>
    <SolidColorBrush x:Key="ChromeCaptionPressedBrush" Color="#0F2438"/>
    <SolidColorBrush x:Key="ChromeCaptionButtonBorderBrush" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="ChromeCaptionDisabledBrush" Color="#7E97B4"/>
    <!-- Close-button red hover/press -->
    <SolidColorBrush x:Key="ChromeCloseHoverBrush" Color="#E81123"/>
    <SolidColorBrush x:Key="ChromeClosePressedBrush" Color="#C42B1C"/>

    <!-- ── Backstage sidebar (FreeX Office-backstage navy rail) ─────────────
         The full-window File-screen nav rail: a dark navy column, light-on-dark
         entries with an accent hover band and an accent selection band, plus an
         icon column. The host (BackstageFrame) overrides Background on a per-app
         basis (FreeW uses its Word #2B579A accent), so these are defaults. -->
    <SolidColorBrush x:Key="ChromeBackstageSidebarBrush" Color="#10253A"/>
    <SolidColorBrush x:Key="ChromeBackstageSidebarHoverBrush" Color="#17324D"/>
    <SolidColorBrush x:Key="ChromeBackstageSidebarSelectedBrush" Color="#0F6D8C"/>
    <SolidColorBrush x:Key="ChromeBackstageSidebarSeparatorBrush" Color="#24445E"/>

    <!-- ════════════════════════════════════════════════════════════════════
         Flat command button — the FreeX "RibbonBtn" look. Transparent until
         hovered; light hover fill + subtle border; pressed accent. Use for the
         title-bar quick buttons (File/New/Open/…) and the footer view buttons.
         ════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ChromeFlatButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ChromeWhiteBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionPressedBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A light-background variant (dark text) for flat buttons on white surfaces. -->
    <Style x:Key="ChromeFlatButtonLightStyle" TargetType="Button" BasedOn="{StaticResource ChromeFlatButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource ChromeTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeButtonHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeButtonPressedBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         Caption (system) buttons: minimize / maximize-restore. Full-height,
         transparent, light hover on the dark title bar. Marked hit-test-visible
         in chrome so clicks land while WindowChrome owns the caption area.
         ════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ChromeCaptionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ChromeWhiteBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentHost"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="False"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close caption button: same shape, red hover/press. -->
    <Style x:Key="ChromeCaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeCaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentHost"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="False"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCloseHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeClosePressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         Status-bar buttons: clean, light-on-dark, rounded hover highlight.
         Use for the footer zoom −/＋ buttons (Button) and the Read Mode /
         Print Layout toggles (ToggleButton).
         ════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ChromeStatusButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource ChromeWhiteBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Glyph"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionPressedBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChromeStatusToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource ChromeWhiteBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Glyph"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionPressedBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionPressedBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         Backstage sidebar nav button — the FreeX "SsNavBtn" look. Light-on-dark,
         left-aligned label (with an optional leading icon), transparent until
         hovered (accent-dark band). Use for the File-screen nav entries.

         The selected entry uses BackstageSidebarNavButtonActive (accent band +
         semibold). The frame swaps the style on selection. Background/hover are
         driven through the brush keys above so a host can re-tint the rail.
         ════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="BackstageSidebarNavButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ChromeWhiteBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="22,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource ChromeBackstageSidebarHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource ChromeBackstageSidebarHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BackstageSidebarNavButtonActive" BasedOn="{StaticResource BackstageSidebarNavButton}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ChromeBackstageSidebarSelectedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The back-arrow button at the top of the rail: same look, but compact and
         left-aligned (not stretched). -->
    <Style x:Key="BackstageSidebarBackButton" BasedOn="{StaticResource BackstageSidebarNavButton}" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Padding" Value="16,11"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <!-- Icon glyph inside a sidebar entry: 22px, white, with a trailing gap to the label. -->
    <Style x:Key="BackstageSidebarIcon" TargetType="{x:Type wpf:RibbonIcon}">
        <Setter Property="IconSize" Value="22"/>
        <Setter Property="Foreground" Value="{StaticResource ChromeWhiteBrush}"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
