<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- ════════════════════════════════════════════════════════════════════
         Shared window-chrome resources.

         App-neutral port of the FreeX window chrome (title bar caption buttons,
         flat command buttons, clean status-bar buttons). Both FreeW and FreeX
         could merge this dictionary; it defines its own brushes (prefixed
         "Chrome*") so it has no dependency on any app-specific resource keys.

         Keys exposed:
           ChromeFlatButtonStyle          — flat command button (no border/fill until hover)
           ChromeCaptionButtonStyle       — min / max-restore caption button (light-on-dark)
           ChromeCaptionCloseButtonStyle  — close caption button (red hover)
           ChromeStatusButtonStyle        — clean status-bar button (light-on-dark, rounded hover)
           ChromeStatusToggleButtonStyle  — clean status-bar toggle button
         ════════════════════════════════════════════════════════════════════ -->

    <!-- ── Brushes (self-contained; tuned to the FreeX #17324D navy title/status bar) ──── -->
    <!-- NEUTRAL chrome brushes — tokenized (WS-G round 8).
         ThemeNeutralWhiteBrush / ThemeNeutralTextBrush / ThemeNeutralMutedTextBrush /
         ThemeNeutralDangerBrush are registered by WpfThemeApplier.BuildResources with values
         byte-identical across FreeX/FreeW/FreeP (all three share the same neutral palette).
         We embed the same values directly here as concrete SolidColorBrush resources so that
         BackstageFrame (which merges this dict into its own UserControl.Resources scope) can
         resolve Chrome* keys without walking up to Application resources.  Using DynamicResource
         aliases here caused InvalidCastException / InvalidOperationException because WPF returned
         the ResourceReferenceExpression object rather than the resolved Brush when the element was
         not yet attached to the visual tree.  The values are hardcoded to match the neutral palette
         (all three brand themes share identical neutral values, so this is safe). -->
    <SolidColorBrush x:Key="ChromeWhiteBrush"     Color="#FFFFFF"/>   <!-- ThemeNeutralWhite  -->
    <SolidColorBrush x:Key="ChromeTextBrush"      Color="#1F1F1F"/>   <!-- ThemeNeutralText   -->
    <SolidColorBrush x:Key="ChromeMutedTextBrush" Color="#5F6368"/>   <!-- ThemeNeutralMuted  -->
    <!-- Close-button pressed: Danger role (#C42B1C) — identical across all three brand themes. -->
    <SolidColorBrush x:Key="ChromeClosePressedBrush" Color="#C42B1C"/>  <!-- ThemeNeutralDanger -->

    <!-- ACCENT-DERIVED brushes — tokenized (WS-G round 9).
         ThemeAccent*Brush / ThemeRibbonButtonHoverBrush are registered by WpfThemeApplier.BuildResources
         with per-app values: FreeX/FreeW emit teal, FreeP emits brick.  The Chrome* aliases below
         re-expose the tokens.  Must be referenced with {DynamicResource} in style setters — see note above. -->
    <!-- Flat (light-background) command-button hover/press fills — accent soft/pressed family -->
    <DynamicResource x:Key="ChromeButtonHoverBrush"   ResourceKey="ThemeAccentSoftBrush"/>
    <DynamicResource x:Key="ChromeButtonPressedBrush" ResourceKey="ThemeAccentPressedBrush"/>
    <!-- ChromeButtonBorderBrush (#8FC3D2) is a mid-tone accent tint; closest available role is the
         base accent (the flat-button hover border should read as the brand accent). -->
    <DynamicResource x:Key="ChromeButtonBorderBrush"  ResourceKey="ThemeAccentBrush"/>
    <!-- Base accent: the primary brand accent for each app (teal for FreeX/FreeW, brick for FreeP). -->
    <DynamicResource x:Key="ChromeAccentBrush"        ResourceKey="ThemeAccentBrush"/>
    <!-- Title-bar / status-bar (dark-background) hover/press fills — FreeX #17324D navy family -->
    <SolidColorBrush x:Key="ChromeCaptionHoverBrush"        Color="#264B6B"/>
    <SolidColorBrush x:Key="ChromeCaptionPressedBrush"      Color="#0F2438"/>
    <!-- TitleBarButtonBorder alpha key — ACCENT-DERIVED (lives in accent family), deferred -->
    <SolidColorBrush x:Key="ChromeCaptionButtonBorderBrush" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="ChromeCaptionDisabledBrush"     Color="#7E97B4"/>
    <!-- Close-button red hover — close to Danger but distinct (#E81123 vs #C42B1C), structural -->
    <SolidColorBrush x:Key="ChromeCloseHoverBrush"          Color="#E81123"/>

    <!-- ── Backstage sidebar (FreeX Office-backstage navy rail) ─────────────
         The full-window File-screen nav rail: a dark navy column, light-on-dark
         entries with an accent hover band and an accent selection band, plus an
         icon column. The host (BackstageFrame) overrides Background on a per-app
         basis (FreeW uses its Word #2B579A accent), so these are defaults. -->
    <!-- ════════════════════════════════════════════════════════════════════
         Flat command button — the FreeX "RibbonBtn" look. Transparent until
         hovered; light hover fill + subtle border; pressed accent. Use for the
         title-bar quick buttons (File/New/Open/…) and the footer view buttons.
         ════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ChromeFlatButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ChromeWhiteBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionPressedBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A light-background variant (dark text) for flat buttons on white surfaces. -->
    <Style x:Key="ChromeFlatButtonLightStyle" TargetType="Button" BasedOn="{StaticResource ChromeFlatButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ChromeButtonHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ChromeButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ChromeButtonPressedBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ChromeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ChromeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         Caption (system) buttons: minimize / maximize-restore. Full-height,
         transparent, light hover on the dark title bar. Marked hit-test-visible
         in chrome so clicks land while WindowChrome owns the caption area.
         ════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ChromeCaptionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ChromeWhiteBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentHost"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="False"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close caption button: same shape, red hover/press. -->
    <Style x:Key="ChromeCaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeCaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentHost"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="False"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCloseHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ChromeClosePressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         Status-bar buttons: clean, light-on-dark, rounded hover highlight.
         Use for the footer zoom −/＋ buttons (Button) and the Read Mode /
         Print Layout toggles (ToggleButton).
         ════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ChromeStatusButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ChromeWhiteBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Glyph"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionPressedBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChromeStatusToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ChromeWhiteBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Glyph"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionPressedBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeCaptionPressedBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeCaptionButtonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         Backstage sidebar nav button — the FreeX "SsNavBtn" look. Light-on-dark,
         left-aligned label (with an optional leading icon), transparent until
         hovered (accent-dark band). Use for the File-screen nav entries.

         The selected entry uses BackstageSidebarNavButtonActive (accent band +
         semibold). The frame swaps the style on selection. Background/hover are
         driven through the brush keys above so a host can re-tint the rail.
         ════════════════════════════════════════════════════════════════════ -->
</ResourceDictionary>
