<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- RibbonIconFactorySvgTests drives the slug-candidate helper directly rather than by
         reflection, so a change to its signature is a build error in the test lane. -->
    <InternalsVisibleTo Include="FreeX.App.Host.Tests" />
    <!-- r279: RibbonThemeBrushes is driven directly so a signature change is a build error. -->
    <InternalsVisibleTo Include="Free.Shared.Ribbon.Wpf.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Free.Shared.Ribbon/Free.Shared.Ribbon.csproj" />
    <ProjectReference Include="../Free.Shared.Shell.Wpf/Free.Shared.Shell.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpVectors.Wpf" />
  </ItemGroup>

</Project>
