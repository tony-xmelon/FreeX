<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════════
         Shared dialog control theme.

         App-neutral modern flat styles for the controls used in code-built
         dialogs (Button / TextBox / ComboBox / CheckBox / GroupBox / Label),
         so a host's dialogs read as one clean Word-style surface instead of
         the dated default WPF (Aero) theme. Scoped via DialogWindow (merged
         into the window's own resources) so it never touches the ribbon.

         Keys: DialogPrimaryButton (accent OK/primary button). Everything else
         is default-targeted (applies to every plain control in the dialog).
         ════════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="DialogText" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="DialogBorder" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="DialogFieldBorder" Color="#B7BCC2"/>
    <SolidColorBrush x:Key="DialogAccent" Color="#0F6D8C"/>
    <SolidColorBrush x:Key="DialogAccentDark" Color="#0B556E"/>
    <SolidColorBrush x:Key="DialogHover" Color="#E6F6FA"/>
    <SolidColorBrush x:Key="DialogPressed" Color="#CCEAF2"/>

    <!-- Standard dialog button: white resting fill + subtle border; hover/press wash with accent border. -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="12,3"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource DialogText}"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource DialogHover}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource DialogAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource DialogPressed}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource DialogAccent}"/>
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource DialogAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#9AA0A6"/>
                            <Setter TargetName="bd" Property="Background" Value="#F3F3F3"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#E0E0E0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent primary button (OK / Insert / Apply): teal fill, white text. -->
    <Style x:Key="DialogPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="{StaticResource DialogAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource DialogAccentDark}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource DialogAccentDark}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#093F52"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#093F52"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#9FC4CF"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#9FC4CF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input: white field, calm border, accent focus ring (property-only — no template rewrite). -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="Foreground" Value="{StaticResource DialogText}"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogFieldBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccent}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox: align sizing/typography with the text fields (property-only, keeps the default template). -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="Foreground" Value="{StaticResource DialogText}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- CheckBox / RadioButton: consistent typography + comfortable hit target. -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource DialogText}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,0,0,0"/>
    </Style>
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource DialogText}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,0,0,0"/>
    </Style>

    <!-- Labels / static text default to the dialog typography. -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource DialogText}"/>
    </Style>
    <Style TargetType="{x:Type Label}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource DialogText}"/>
        <Setter Property="Padding" Value="0,0,0,0"/>
    </Style>

    <!-- GroupBox: clean accent-tinted header, light rule. -->
    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource DialogAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

</ResourceDictionary>
