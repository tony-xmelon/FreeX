<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- PdfPig used to synthesize PDFs in-test (no binary fixtures); mirrors FreeW.Core.IO.Tests pattern -->
    <PackageReference Include="UglyToad.PdfPig" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Free.Shared.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FreeX.Core.Model\FreeX.Core.Model.csproj" />
    <ProjectReference Include="..\..\src\FreeX.Core.IO\FreeX.Core.IO.csproj" />
    <ProjectReference Include="..\..\src\FreeX.Core.Calc\FreeX.Core.Calc.csproj" />
    <ProjectReference Include="..\..\src\FreeX.Core.Commands\FreeX.Core.Commands.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Drawing\Free.Shared.Drawing.csproj" />
    <ProjectReference Include="..\..\tools\FreeX.XlsxPackageDiagnostics\FreeX.XlsxPackageDiagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CommandTestInfrastructure\TestCommandContext.cs" Link="TestCommandContext.cs" />
    <Compile Include="..\SharedTestInfrastructure\FreeX\TestFileAdapter.cs" Link="TestFileAdapter.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\Simple.xls" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Simple.xlsb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\CellGradientFillLinear.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Excel_native_shapes_fill_outline_004.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Free.Shared.IO.FileFormatDescriptor" Alias="FileFormatDescriptor" />
    <Using Include="Free.Shared.Opc" />
    <Using Include="FreeX.XlsxPackageDiagnostics" />
  </ItemGroup>
</Project>
