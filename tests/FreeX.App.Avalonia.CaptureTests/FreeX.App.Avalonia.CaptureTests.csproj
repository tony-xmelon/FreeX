<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="CaptureTests.Shared.props" />
  <PropertyGroup>
    <VSTestTestCaseFilter>FullyQualifiedName~AdvancedFilterOwnedModal_ClosesThroughEscapeContract|FullyQualifiedName~AllowEditRangeDialog_UsesWpfRangeBoxAsInitialFocusAndTabOrigin|FullyQualifiedName~AssignedDialogs_CycleFocusAndHonorDefaultCancelContracts|FullyQualifiedName~AuditedWpfModelessDialogs_KeepOwnerInteractiveAndReturnFromProductionOpeners|FullyQualifiedName~CaptureParitySurfaces_CapturesChartStyleCatalogDialog</VSTestTestCaseFilter>
    <!-- CapturesChartStyleCatalogDialog asserts real PNG bytes. Avalonia's lightweight headless
         drawing does not rasterize, so RenderTargetBitmap.Save writes no file and the capture reads
         back empty. Every Batch* project already renders through Skia; this one was missed. -->
    <DefineConstants>$(DefineConstants);AVALONIA_CAPTURE_PER_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Batch6HeadlessTestApp.cs" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>
</Project>
