<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="CaptureTests.Shared.props" />
  <PropertyGroup>
    <AssemblyName>FreeX.App.Avalonia.CaptureTests.Batch3</AssemblyName>
    <!-- Assert real PNG bytes: Avalonia's lightweight headless drawing does not rasterize, so
         RenderTargetBitmap.Save writes no file and every capture reads back empty. -->
    <DefineConstants>$(DefineConstants);AVALONIA_CAPTURE_PER_TEST</DefineConstants>
    <VSTestTestCaseFilter>FullyQualifiedName~CaptureParitySurfaces_OpensAndRendersFormerlyMissingProductionDialog|FullyQualifiedName~CaptureParitySurfaces_ProducesGridAndDialogPngs|FullyQualifiedName~CaptureParitySurfaces_RejectsManagedNameBoxDropdownAsAuthoritativeEvidence|FullyQualifiedName~ChartFormatFamily_MatchesWpfInitialFocusTabCycleAndEscape|FullyQualifiedName~ConfirmPasswordDialog_UsesSharedProtectionInputFocusAndEscapeLifecycle|FullyQualifiedName~SpellCheckDialog_MatchesWpfFocusCycleEscapeAndDefaultAction</VSTestTestCaseFilter>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Batch6HeadlessTestApp.cs" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>
</Project>
