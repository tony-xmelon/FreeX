<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="CaptureTests.Shared.props" />
  <PropertyGroup>
    <AssemblyName>FreeX.App.Avalonia.CaptureTests.Batch6</AssemblyName>
    <!-- Goal Seek's wrapped status text can loop in Avalonia's lightweight headless formatter.
         Keep its evidence isolated and render it through Skia, as the desktop app does. -->
    <DefineConstants>$(DefineConstants);AVALONIA_CAPTURE_PER_TEST</DefineConstants>
    <VSTestTestCaseFilter>FullyQualifiedName~TargetedGoalSeekStatusCapture_WritesNonBlank380x190Png</VSTestTestCaseFilter>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Batch6HeadlessTestApp.cs" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>
</Project>
