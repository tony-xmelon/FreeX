<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="CaptureTests.Shared.props" />
  <PropertyGroup>
    <AssemblyName>FreeX.App.Avalonia.CaptureTests.Batch4</AssemblyName>
    <!-- Assert real PNG bytes: Avalonia's lightweight headless drawing does not rasterize, so
         RenderTargetBitmap.Save writes no file and every capture reads back empty. -->
    <DefineConstants>$(DefineConstants);AVALONIA_CAPTURE_PER_TEST</DefineConstants>
    <VSTestTestCaseFilter>FullyQualifiedName~ConsolidateCapture_UsesFixtureStateAndProducesFixedNonBlankSurface|FullyQualifiedName~ConsolidateDialog_UsesWpfFunctionComboAsInitialFocusAndCyclesKeyboardLifecycle|FullyQualifiedName~DialogInteractionRoute_StableFailureCohortPassesSharedContract|FullyQualifiedName~HeaderFooterInteractionRoute_OpensTheDedicatedProductionEditor|FullyQualifiedName~HighlightCellsRuleDialog_UsesWpfConditionSelectorAsInitialFocusAndTabOrigin|FullyQualifiedName~TextToColumnsDialogContract_PassesInitialFocusTabCycleAndEscape</VSTestTestCaseFilter>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Batch6HeadlessTestApp.cs" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>
</Project>
