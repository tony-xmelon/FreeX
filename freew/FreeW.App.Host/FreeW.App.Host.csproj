<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>FreeW.App.Host.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The on-demand DOCX visual-fidelity harness (tools/FreeW.RenderCompare) renders pages through the
         real print path (internal PrintLayout.BuildPaginator). Tooling-only; the shipped app is unchanged. -->
    <InternalsVisibleTo Include="FreeW.RenderCompare" />
    <!-- Tests reach the internal print paginator (HeaderFooterPaginator) directly. -->
    <InternalsVisibleTo Include="FreeW.App.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Free.Shared.Ribbon\Free.Shared.Ribbon.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Ribbon.Wpf\Free.Shared.Ribbon.Wpf.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Shell\Free.Shared.Shell.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.AppServices\Free.Shared.AppServices.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Commands\Free.Shared.Commands.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Opc\Free.Shared.Opc.csproj" />
    <ProjectReference Include="..\FreeW.Core.Model\FreeW.Core.Model.csproj" />
    <ProjectReference Include="..\FreeW.Core.IO\FreeW.Core.IO.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Free.Shared.Ribbon" />
    <Using Include="Free.Shared.AppServices" />
    <Using Include="Free.Shared.Shell" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpVectors.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\FreeW.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\FreeW.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- FreeW's own icons: Word-specific artwork plus a few Word-unique glyphs. -->
    <Content Include="Resources\CommandIconsSvg\**\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <!-- Reuse FreeX's actual Office-quality icons wherever a command has a FreeX equivalent, so e.g.
         Paste is byte-identical to FreeX. Linked (single source of truth), not copied; FreeW's folder
         above holds only the Word-specific icons and must not contain any filename that also exists in
         FreeX's set (that would double-emit to the same output path). -->
    <Content Include="..\..\src\FreeX.App.Host\Resources\CommandIconsSvg\**\*.svg"
             Link="Resources\CommandIconsSvg\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Resources\FreeW.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
