<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <StartupObject>FreeW.App.Host.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The on-demand DOCX visual-fidelity harness (tools/FreeW.RenderCompare) renders pages through the
         same print/preview paginator (internal PrintLayout.BuildPaginator). -->
    <InternalsVisibleTo Include="FreeW.RenderCompare" />
    <!-- Tests reach the internal print paginator (HeaderFooterPaginator) directly. -->
    <InternalsVisibleTo Include="FreeW.App.Host.Tests" />
    <!-- FidelityRender composite path uses internal overlay/chrome/column helpers. -->
    <InternalsVisibleTo Include="FreeW.FidelityRender" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Free.Shared.Ribbon\Free.Shared.Ribbon.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Ribbon.Wpf\Free.Shared.Ribbon.Wpf.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Shell\Free.Shared.Shell.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Shell.Wpf\Free.Shared.Shell.Wpf.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Theme\Free.Shared.Theme.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Theme.Wpf\Free.Shared.Theme.Wpf.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.AppServices\Free.Shared.AppServices.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Commands\Free.Shared.Commands.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Opc\Free.Shared.Opc.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Pdf\Free.Shared.Pdf.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Pdf.Wpf\Free.Shared.Pdf.Wpf.csproj" />
    <ProjectReference Include="..\FreeW.App.Localization\FreeW.App.Localization.csproj" />
    <ProjectReference Include="..\FreeW.App.Presentation\FreeW.App.Presentation.csproj" />
    <ProjectReference Include="..\FreeW.Ribbon.Definitions\FreeW.Ribbon.Definitions.csproj" />
    <ProjectReference Include="..\FreeW.Core.Model\FreeW.Core.Model.csproj" />
    <ProjectReference Include="..\FreeW.Core.IO\FreeW.Core.IO.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-box Windows text-to-speech (System.Speech.Synthesis) for Review > Read Aloud. Local synthesis,
         no cloud; Microsoft-published package (the modern .NET home of the classic System.Speech API).
         Version is centrally managed in Directory.Packages.props. -->
    <PackageReference Include="System.Speech" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="Free.Shared.IO" />
    <Using Include="Free.Shared.Ribbon" />
    <Using Include="Free.Shared.AppServices" />
    <Using Include="Free.Shared.Shell" />
    <Using Include="FreeW.App.Presentation.DocumentView" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpVectors.Wpf" />
    <!-- Real PDF export (PdfExport.cs). Same centrally-managed PDFsharp package FreeX uses for its
         PDF exporter — reused rather than introducing a new PDF dependency. -->
    <PackageReference Include="PDFsharp-WPF" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\shared\Free.Shared.Shell\Resources\FreeW.ico" Link="Resources\FreeW.ico" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="FreeW.Legal.ProjectLicense.txt" />
    <EmbeddedResource Include="..\..\docs\legal\legal-notices.md" LogicalName="FreeW.Legal.LegalNotices.md" />
    <EmbeddedResource Include="..\..\docs\legal\privacy.md" LogicalName="FreeW.Legal.PrivacyNotice.md" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_NOTICES.md" LogicalName="FreeW.Legal.ThirdPartyNotices.md" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_LICENSES.md" LogicalName="FreeW.Legal.ThirdPartyLicenses.md" />
    <!-- Bundled English thesaurus: compact Moby II derivative (~3 000 headwords, public domain).
         Embedded so the lookup works with no file I/O and ships as a single DLL with no deploy steps. -->
    <EmbeddedResource Include="Resources\thesaurus-en.txt" LogicalName="FreeW.App.Host.Resources.thesaurus-en.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\shared\Free.Shared.Shell\Resources\FreeW.ico"
             Link="Resources\FreeW.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- FreeW's own icons: Word-specific artwork plus a few Word-unique glyphs. -->
    <Content Include="Resources\CommandIconsSvg\**\*.svg"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- Insert > Icons content library: curated monochrome SVGs for document insertion (W20). -->
    <Content Include="Resources\ContentIconsSvg\**\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <!-- Reuse FreeX's actual Office-quality icons wherever a command has a FreeX equivalent. A small
         reviewed set has intentional FreeW-specific variants with the same slug; exclude those FreeX
         items so publish has one deterministic source path and the FreeW artwork wins. -->
    <Content Include="..\..\src\FreeX.Ribbon.Definitions\Resources\CommandIconsSvg\**\*.svg"
             Exclude="..\..\src\FreeX.Ribbon.Definitions\Resources\CommandIconsSvg\arrange-all.svg;..\..\src\FreeX.Ribbon.Definitions\Resources\CommandIconsSvg\breaks.svg;..\..\src\FreeX.Ribbon.Definitions\Resources\CommandIconsSvg\eraser.svg;..\..\src\FreeX.Ribbon.Definitions\Resources\CommandIconsSvg\new-window.svg;..\..\src\FreeX.Ribbon.Definitions\Resources\CommandIconsSvg\paste-special.svg;..\..\src\FreeX.Ribbon.Definitions\Resources\CommandIconsSvg\show-comments.svg;..\..\src\FreeX.Ribbon.Definitions\Resources\CommandIconsSvg\show-notes.svg;..\..\src\FreeX.Ribbon.Definitions\Resources\CommandIconsSvg\sort.svg;..\..\src\FreeX.Ribbon.Definitions\Resources\CommandIconsSvg\strikethrough.svg;..\..\src\FreeX.Ribbon.Definitions\Resources\CommandIconsSvg\theme-colors.svg;..\..\src\FreeX.Ribbon.Definitions\Resources\CommandIconsSvg\theme-effects.svg;..\..\src\FreeX.Ribbon.Definitions\Resources\CommandIconsSvg\theme-fonts.svg"
             Link="Resources\CommandIconsSvg\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>..\..\shared\Free.Shared.Shell\Resources\FreeW.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
