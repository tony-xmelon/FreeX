<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ribbon="clr-namespace:Free.Shared.Ribbon.Wpf;assembly=Free.Shared.Ribbon.Wpf">

    <!-- Brushes the shared renderer looks up by key (with graceful fallbacks if absent). -->
    <SolidColorBrush x:Key="FreeXRibbonSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FreeXBorderBrush" Color="#E2E2E2"/>
    <SolidColorBrush x:Key="FreeXBorderStrongBrush" Color="#B5B5B5"/>
    <SolidColorBrush x:Key="FreeXTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="FreeXMutedTextBrush" Color="#707070"/>
    <SolidColorBrush x:Key="FreeXAccentBrush" Color="#2B579A"/>
    <SolidColorBrush x:Key="FreeXAccentDarkBrush" Color="#1F4377"/>
    <SolidColorBrush x:Key="FreeXAccentPressedBrush" Color="#CCE0F5"/>
    <SolidColorBrush x:Key="FreeXAccentSoftBrush" Color="#EAF1FB"/>
    <SolidColorBrush x:Key="FreeXRibbonButtonHoverBrush" Color="#EAF1FB"/>

    <!-- ── Ribbon button styles (mirrors FreeX's RibbonBtn vocabulary) ───────── -->
    <Style x:Key="RibbonBtn" TargetType="Button">
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Margin" Value="1,1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource FreeXTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource FreeXAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.58"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource FreeXRibbonButtonHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource FreeXBorderStrongBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource FreeXAccentPressedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource FreeXAccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource FreeXMutedTextBrush}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RibbonToggleBtn" TargetType="ToggleButton">
        <Setter Property="Padding" Value="3,1"/>
        <Setter Property="Margin" Value="1,1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource FreeXTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource FreeXAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.58"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource FreeXRibbonButtonHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource FreeXBorderStrongBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource FreeXAccentPressedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource FreeXAccentBrush}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource FreeXAccentPressedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource FreeXAccentDarkBrush}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource FreeXMutedTextBrush}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Group label text style -->
    <Style x:Key="GroupLbl" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource FreeXMutedTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RibbonGroupPanel" TargetType="Grid">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="96"/>
        <Setter Property="ribbon:RibbonMetadata.Role" Value="RibbonGroup"/>
    </Style>

    <Style x:Key="RibbonGroupLabelBorder" TargetType="Border">
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource FreeXBorderBrush}"/>
        <Setter Property="MinHeight" Value="18"/>
    </Style>

    <Style x:Key="RibbonGroupDivider" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Fill" Value="{StaticResource FreeXBorderBrush}"/>
        <Setter Property="Margin" Value="2,5,3,18"/>
    </Style>

    <Style x:Key="RibbonLargeButton" BasedOn="{StaticResource RibbonBtn}" TargetType="Button">
        <Setter Property="Width" Value="70"/>
        <Setter Property="Height" Value="76"/>
        <Setter Property="Padding" Value="3,2"/>
    </Style>

    <Style x:Key="RibbonIconButton" BasedOn="{StaticResource RibbonBtn}" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="2"/>
    </Style>

    <Style x:Key="RibbonIconToggleButton" BasedOn="{StaticResource RibbonToggleBtn}" TargetType="ToggleButton">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="2"/>
    </Style>

</ResourceDictionary>
