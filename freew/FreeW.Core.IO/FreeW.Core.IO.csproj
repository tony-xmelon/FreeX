<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Read-only PDF text import (UglyToad.PdfPig, Apache-2.0); DocumentLayoutAnalysis provides the
         reading-order text extractor. -->
    <PackageReference Include="UglyToad.PdfPig" />
    <PackageReference Include="UglyToad.PdfPig.DocumentLayoutAnalysis" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FreeW.Core.Model\FreeW.Core.Model.csproj" />
    <ProjectReference Include="..\..\shared\Free.Shared.Opc\Free.Shared.Opc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lets the IO test project exercise the internal ODTTF obfuscation helper (Ooxml.ObfuscateFont). -->
    <InternalsVisibleTo Include="FreeW.Core.IO.Tests" />
  </ItemGroup>
</Project>
